---
/*
|-------------------------------------------------------------------------------
| AboutSection — JMR Visuals Portfolio
|-------------------------------------------------------------------------------
|
| Collage laid out on the 1702px Figma About frame, measured in --u (one Figma
| pixel at the current viewport width): two text columns, the portrait, the
| hand reaching over an outlined GET IN TOUCH heading, and a white rule that
| also cuts the hand off. Below 768px the pieces stack in flow.
|
*/
interface Props {
  blurb: string;
  text: string;
  portrait: string;
  portraitAlt: string;
}

const { blurb, text, portrait, portraitAlt } = Astro.props;
---

<section class="about" aria-label="About">
  <h1 class="visually-hidden">About José Mercado Ruiz</h1>

  <h2 class="about-heading" aria-label="Get in touch">
    <span aria-hidden="true">GET IN <span class="is-filled">T</span>O<span class="is-filled">UC</span>H</span>
  </h2>

  <img
    class="about-hand"
    src="/hero/hand-painting.png"
    alt=""
    width="1728"
    height="732"
    loading="eager"
  />

  <p class="about-blurb">{blurb}</p>
  <p class="about-text">{text}</p>

  <div class="about-photo">
    <div class="about-photo-crop">
      <img src={portrait} alt={portraitAlt} loading="eager" decoding="async" />
    </div>
  </div>
</section>

<style>
  .about {
    --u: calc(100vw / 1702);
    position: relative;
    height: calc(1092 * var(--u));
    overflow: hidden;
    background: var(--color-bone);
    color: var(--color-chalk);
  }

  .about::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: calc(1450 * var(--u));
    height: 3px;
    background: var(--color-chalk);
  }

  /* 6.22 is the ink width of the heading in em; it spans from the left edge to the photo's right edge. */
  .about-heading {
    position: absolute;
    left: calc(-7 * var(--u));
    bottom: calc(7 * var(--u));
    margin: 0;
    font-family: var(--font-hero);
    font-size: calc(1450 * var(--u) / 6.22);
    font-weight: var(--font-weight-black);
    letter-spacing: -0.11em;
    line-height: 0.8;
    text-transform: uppercase;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 2px var(--color-chalk);
  }

  .about-heading .is-filled {
    color: var(--color-chalk);
    -webkit-text-stroke: 0;
  }

  .about-hand {
    position: absolute;
    left: calc(-136.8 * var(--u));
    top: calc(463 * var(--u));
    width: calc(1231.7 * var(--u));
    height: calc(521.8 * var(--u));
    max-width: none;
    transform: rotate(-162.29deg) scaleY(-1);
    pointer-events: none;
  }

  .about-blurb,
  .about-text {
    position: absolute;
    top: calc(150 * var(--u));
    margin: 0;
    max-width: none;
    font-family: var(--font-hero-mono);
    font-size: max(0.875rem, calc(23.458 * var(--u)));
    line-height: 1.255;
  }

  .about-blurb {
    left: calc(212 * var(--u));
    width: calc(275 * var(--u));
  }

  .about-text {
    left: calc(548 * var(--u));
    width: calc(447 * var(--u));
  }

  .about-photo {
    position: absolute;
    left: calc(1055 * var(--u));
    top: calc(104 * var(--u));
    width: calc(395 * var(--u));
    height: calc(543 * var(--u));
    overflow: hidden;
  }

  /* The Figma crop frames the full 395x647 box; the top 104px sit under the header. */
  .about-photo-crop {
    position: absolute;
    left: 0;
    top: calc(-104 * var(--u));
    width: 100%;
    height: calc(647 * var(--u));
    overflow: hidden;
  }

  .about-photo-crop img {
    position: absolute;
    left: -29.73%;
    top: -34.4%;
    width: 174.79%;
    height: 142.52%;
    max-width: none;
  }

  @media (max-width: 767px) {
    .about {
      display: flex;
      flex-direction: column;
      gap: 6vw;
      height: auto;
      padding: calc(var(--header-height) + 6vw) 6vw 0;
    }

    .about::after {
      left: 6vw;
      width: calc(100% - 12vw);
    }

    .about-blurb,
    .about-text {
      position: static;
      width: auto;
      font-size: max(0.875rem, 3.8vw);
    }

    .about-photo {
      position: relative;
      left: auto;
      top: auto;
      width: 100%;
      height: auto;
      aspect-ratio: 395 / 543;
    }

    .about-photo-crop {
      top: calc(-104 / 543 * 100%);
      height: calc(647 / 543 * 100%);
    }

    .about-hand {
      position: relative;
      left: -26vw;
      top: -12vw;
      order: 1;
      transform: rotate(-137.29deg) scaleY(-1);
      z-index: 1;
      align-self: flex-start;
      width: 120vw;
      height: auto;
      aspect-ratio: 1728 / 732;
      margin: 0 0 -14vw -12vw;
    }

    .about-heading {
      position: relative;
      left: auto;
      bottom: auto;
      order: 2;
      font-size: calc((100vw - 12vw) / 6.22);
      margin: 0 0 2.5vw -1vw;
    }
  }
</style>
