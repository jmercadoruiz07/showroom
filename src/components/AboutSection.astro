---
/*
|-------------------------------------------------------------------------------
| AboutSection — JMR Visuals Portfolio
|-------------------------------------------------------------------------------
|
| Collage laid out on the 1702px Figma About frame, measured in --u (one Figma
| pixel at the current viewport width): contact details and a statement in two
| text columns, the portrait, and the hand reaching over the outlined GET IN
| TOUCH heading. The hand is two layers with the heading between them. Below
| 768px the pieces stack in flow and the heading and hand scale together.
|
*/
import OutlinedWordmark from './OutlinedWordmark.astro';

interface Props {
  email: string;
  altEmail: string;
  statement: string;
  portrait: string;
  portraitAlt: string;
}

const { email, altEmail, statement, portrait, portraitAlt } = Astro.props;

// Ink gap between each letter pair of the heading in em, measured from widescreen Black at
// zero tracking. Each pair is pulled to TARGET_GAP so the spacing is uniform and tight.
const NATURAL_GAP: Record<string, number> = {
  GE: 0.095, ET: 0.035, IN: 0.125, TO: 0.015, OU: 0.079, UC: 0.086, CH: 0.072,
};
const TARGET_GAP = 0.05;
// Calibrated against the rendered heading (browsers drop some pair kerning across spans).
const NATURAL_INK_WIDTH = 7.224;

const HEADING = 'GET IN TOUCH';

const headingKerns = HEADING.split(' ').flatMap((word) =>
  [...word].map((char, index) => {
    const next = word[index + 1];
    return next ? TARGET_GAP - NATURAL_GAP[char + next] : 0;
  }),
);

const headingInkWidth = NATURAL_INK_WIDTH + headingKerns.reduce((sum, kern) => sum + kern, 0);
---

<section class="about" aria-label="About">
  <h1 class="visually-hidden">About José Mercado Ruiz</h1>

  <div class="about-touch">
    <img
      class="about-hand about-hand-behind"
      src="/about/hand-behind.png"
      alt=""
      width="2050"
      height="869"
      loading="eager"
    />

    <h2 class="about-heading" aria-label="Get in touch" style={`--ink-width: ${headingInkWidth}`}>
      <OutlinedWordmark text={HEADING} kerns={headingKerns} fillNeighbours />
    </h2>

    <img
      class="about-hand about-hand-front"
      src="/about/hand-front.png"
      alt=""
      width="2046"
      height="893"
      loading="eager"
    />
  </div>

  <div class="about-contact">
    <p>CONTACT</p>
    <p>{altEmail}</p>
    <a href={`mailto:${email}`}>{email}</a>
  </div>
  <p class="about-statement">{statement}</p>

  <div class="about-photo">
    <img src={portrait} alt={portraitAlt} loading="eager" decoding="async" />
  </div>
</section>

<style>
  .about {
    --u: calc(100vw / 1702);
    position: relative;
    height: calc(973 * var(--u));
    overflow: hidden;
    background: var(--color-bone);
    color: var(--color-chalk);
  }

  /* Hands and heading share one frame so they scale together: it starts at the top of the hands (y 245 in
     the design) and ends at the bottom of the heading (y 898). */
  .about-touch {
    position: absolute;
    left: 0;
    top: calc(245 * var(--u));
    width: calc(1702 * var(--u));
    height: calc(653 * var(--u));
    pointer-events: none;
  }

  /* --ink-width is the heading's ink width in em; the heading spans 1394 design pixels from x 55 to the photo's right edge. */
  .about-heading {
    --wordmark-stroke-width: 2px;
    --wordmark-gap: 0.256em;
    position: absolute;
    left: calc(55 * var(--u) - 0.03em);
    bottom: 0;
    z-index: 1;
    margin: 0;
    font-size: calc(1394 * var(--u) / var(--ink-width));
    line-height: 0.8;
  }

  .about-hand {
    position: absolute;
    max-width: none;
    pointer-events: none;
  }

  .about-hand-behind {
    left: calc(-83.68 * var(--u));
    top: calc(145.56 * var(--u));
    width: calc(1024.627 * var(--u));
    height: calc(434.044 * var(--u));
    transform: rotate(-162.29deg) scaleY(-1);
  }

  .about-hand-front {
    left: calc(-83.54 * var(--u));
    top: calc(152.19 * var(--u));
    z-index: 2;
    width: calc(1022.763 * var(--u));
    height: calc(446.275 * var(--u));
    transform: rotate(-162.47deg) scaleY(-1);
  }

  .about-contact,
  .about-statement {
    position: absolute;
    top: calc(150 * var(--u));
    z-index: 3;
    margin: 0;
    max-width: none;
    font-family: var(--font-hero-mono);
    font-size: max(0.875rem, calc(23.458 * var(--u)));
    line-height: 1.255;
  }

  .about-contact {
    left: calc(133.5 * var(--u));
    width: calc(353 * var(--u));
  }

  .about-contact p {
    margin: 0;
  }

  .about-contact a {
    display: block;
    text-decoration: underline;
  }

  .about-statement {
    left: calc(547.5 * var(--u));
    width: calc(447 * var(--u));
  }

  /* The top of the portrait sits under the header. */
  .about-photo {
    position: absolute;
    left: calc(1055 * var(--u));
    top: 0;
    z-index: 3;
    width: calc(395 * var(--u));
    height: calc(647 * var(--u));
    overflow: hidden;
  }

  .about-photo img {
    position: absolute;
    left: -29.73%;
    top: -34.4%;
    width: 174.79%;
    height: 142.52%;
    max-width: none;
  }

  @media (max-width: 767px) {
    .about {
      display: flex;
      flex-direction: column;
      gap: 6vw;
      height: auto;
      padding: calc(var(--header-height) + 6vw) 6vw 6vw;
    }

    .about-contact,
    .about-statement {
      position: static;
      width: auto;
      font-size: max(0.875rem, 3.8vw);
    }

    .about-photo {
      position: relative;
      left: auto;
      top: auto;
      width: 100%;
      height: auto;
      aspect-ratio: 395 / 647;
    }

    .about-touch {
      --u: calc(88vw / 1394);
      position: relative;
      left: auto;
      top: auto;
      flex: none;
      order: 1;
      margin-left: calc(-55 * var(--u));
    }
  }
</style>
