---
/*
|-------------------------------------------------------------------------------
| AboutSection — JMR Visuals Portfolio
|-------------------------------------------------------------------------------
|
| Dark theme matching original portfolio.
| Widescreen name treatment, portrait on left, bio on right.
| Simple layout with widescreen font for name.
|
*/
interface Props {
  name?: string;
  title?: string;
  bio?: string;
  portrait?: string;
  portraitAlt?: string;
  email?: string;
}

const {
  name = 'JOSE MERCADO RUIZ',
  title = '3D Artist / Designer / Creative Technologist',
  bio = 'A multidisciplinary creative specializing in 3D visualization, print design, and motion graphics. Based in Barcelona, working with clients globally across architecture, product, and brand projects.',
  portrait = '/images/about-portrait.jpg',
  portraitAlt = 'Portrait of Jose Mercado Ruiz',
  email = 'hello@jmrvisuals.com',
} = Astro.props;
---

<section class="about-section" aria-labelledby="about-title">
  <div class="about-grid">
    <div class="about-portrait" aria-hidden="true">
      <img
        src={portrait}
        alt={portraitAlt}
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="about-content">
      <h2 id="about-title" class="about-title">{name}</h2>
      <p class="about-role">{title}</p>

      <div class="about-bio">
        {bio.split('\n\n').map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>

      <footer class="about-contact">
        <a href={`mailto:${email}`} class="contact-link">
          {email}
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </footer>
    </div>
  </div>
</section>

<style>
  .about-section {
    padding: var(--space-3xl) var(--space-xl);
    padding-left: calc(var(--space-xl) * 2);
    background: #1d1f1f;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: var(--space-3xl);
    max-width: var(--max-width-full);
    margin: 0 auto;
    align-items: start;
  }

  .about-portrait {
    position: relative;
  }

  .about-portrait img {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }

  .about-title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 2rem + 4vw, 130px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0 0 var(--space-md);
    color: #ffffff;
  }

  .about-role {
    font-family: var(--font-mono);
    font-size: 20px;
    font-weight: 400;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7);
    margin: 0 0 var(--space-xl);
  }

  .about-bio {
    font-family: var(--font-body);
    font-size: var(--type-base);
    line-height: var(--line-height-relaxed);
    color: #ffffff;
    margin-bottom: var(--space-2xl);
  }

  .about-bio p {
    margin-bottom: var(--space-md);
    max-width: none;
  }

  .about-contact {
    margin-top: var(--space-2xl);
    padding-top: var(--space-xl);
    border-top: 1px solid rgba(255, 255, 255, 0.2);
  }

  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-mono);
    font-size: 20px;
    font-weight: 400;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: #ffffff;
    transition: color var(--duration-fast) var(--ease-quick),
                gap var(--duration-fast) var(--ease-quick);
  }

  .contact-link:hover {
    color: var(--color-oxide);
    gap: var(--space-md);
  }

  @media (max-width: 768px) {
    .about-section {
      padding: var(--space-2xl) var(--space-md);
      padding-left: var(--space-md);
    }

    .about-grid {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }

    .about-portrait {
      max-width: 60%;
      margin: 0 auto;
    }

    .about-title {
      font-size: clamp(2rem, 1.5rem + 4vw, 80px);
    }

    .about-role {
      font-size: 16px;
    }
  }
</style>