---
/*
|-------------------------------------------------------------------------------
| AboutSection — JMR Visuals Portfolio
|-------------------------------------------------------------------------------
|
| Contact details and a statement, the portrait, and the hand reaching over the
| outlined GET IN TOUCH heading (the hand is two layers with the heading between
| them). Three tiers with fixed type sizes: from 1400px a collage laid out on
| the 1702px Figma About frame, from 768px a two-column grid with the heading
| below, and under 768px a single column with the heading above the portrait.
| --u is one Figma pixel; it follows the heading's fixed font size, so the
| heading and hands always scale together.
|
*/
import OutlinedWordmark from './OutlinedWordmark.astro';

interface Props {
  email: string;
  statement: string;
  portrait: string;
  portraitAlt: string;
}

const { email, statement, portrait, portraitAlt } = Astro.props;

// Ink gap between each letter pair of the heading in em, measured from widescreen Black at
// zero tracking. Each pair is pulled to TARGET_GAP so the spacing is uniform and tight.
const NATURAL_GAP: Record<string, number> = {
  GE: 0.095, ET: 0.035, IN: 0.125, TO: 0.015, OU: 0.079, UC: 0.086, CH: 0.072,
};
const TARGET_GAP = 0.05;
// Calibrated against the rendered heading (browsers drop some pair kerning across spans).
const NATURAL_INK_WIDTH = 7.224;

const HEADING = 'GET IN TOUCH';

const headingKerns = HEADING.split(' ').flatMap((word) =>
  [...word].map((char, index) => {
    const next = word[index + 1];
    return next ? TARGET_GAP - NATURAL_GAP[char + next] : 0;
  }),
);

const headingInkWidth = NATURAL_INK_WIDTH + headingKerns.reduce((sum, kern) => sum + kern, 0);
---

<section class="about" aria-label="About" style={`--ink-width: ${headingInkWidth}`}>
  <h1 class="visually-hidden">About José Mercado Ruiz</h1>

  <div class="about-touch">
    <img
      class="about-hand about-hand-behind"
      src="/about/hand-behind.png"
      alt=""
      width="2050"
      height="869"
      loading="eager"
    />

    <h2 class="about-heading" aria-label="Get in touch">
      <OutlinedWordmark text={HEADING} kerns={headingKerns} fillNeighbours />
    </h2>

    <img
      class="about-hand about-hand-front"
      src="/about/hand-front.png"
      alt=""
      width="2046"
      height="893"
      loading="eager"
    />
  </div>

  <div class="about-columns">
    <div class="about-contact">
      <p>CONTACT</p>
      <a href={`mailto:${email}`}>{email}</a>
    </div>
    <p class="about-statement">{statement}</p>

    <div class="about-photo">
      <img src={portrait} alt={portraitAlt} loading="eager" decoding="async" />
    </div>
  </div>
</section>

<style>
  /* --ink-width is the heading's ink width in em and 1394 is its width in design pixels, so --u is the
     design-pixel size implied by the heading's font size. */
  .about {
    --touch-font-size: 10rem;
    --about-text-size: 1.25rem;
    --u: calc(var(--touch-font-size) * var(--ink-width) / 1394);
    position: relative;
    height: calc(973 * var(--u));
    overflow: hidden;
    background: var(--color-bone);
    color: var(--color-chalk);
  }

  /* Hands and heading share one frame: it starts at the top of the hands (y 245 in the design) and
     ends at the bottom of the heading (y 898). */
  .about-touch {
    position: absolute;
    left: 0;
    top: calc(245 * var(--u));
    width: calc(1702 * var(--u));
    height: calc(653 * var(--u));
    pointer-events: none;
  }

  /* The heading spans 1394 design pixels from x 55 to the photo's right edge. */
  .about-heading {
    --wordmark-stroke-width: 2px;
    --wordmark-gap: 0.256em;
    position: absolute;
    left: calc(55 * var(--u) - 0.03em);
    bottom: 0;
    z-index: 1;
    margin: 0;
    font-size: var(--touch-font-size);
    line-height: 0.8;
  }

  .about-hand {
    position: absolute;
    max-width: none;
    pointer-events: none;
  }

  .about-hand-behind {
    left: calc(-83.68 * var(--u));
    top: calc(145.56 * var(--u));
    width: calc(1024.627 * var(--u));
    height: calc(434.044 * var(--u));
    transform: rotate(-162.29deg) scaleY(-1);
  }

  .about-hand-front {
    left: calc(-83.54 * var(--u));
    top: calc(152.19 * var(--u));
    z-index: 2;
    width: calc(1022.763 * var(--u));
    height: calc(446.275 * var(--u));
    transform: rotate(-162.47deg) scaleY(-1);
  }

  /* Contact, statement and portrait are three equal columns across the page gutters (the gallery grid's
     width, leaving room for the vertical wordmark). */
  .about-columns {
    position: absolute;
    top: 0;
    left: var(--grid-gutter);
    right: calc(var(--grid-gutter) + var(--wordmark-gutter));
    z-index: 3;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: var(--grid-gutter);
    align-items: start;
  }

  .about-contact,
  .about-statement {
    margin: calc(150 * var(--u)) 0 0;
    max-width: none;
    font-family: var(--font-hero-mono);
    font-size: var(--about-text-size);
    line-height: 1.255;
  }

  .about-contact p {
    margin: 0;
  }

  .about-contact a {
    display: block;
    text-decoration: underline;
  }

  /* The top of the portrait sits under the header; its height is fixed so it stays clear of the heading. */
  .about-photo {
    position: relative;
    width: 100%;
    height: calc(647 * var(--u));
    overflow: hidden;
  }

  .about-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 85%;
  }

  /* Tablet: text beside the portrait, heading and hands below. */
  @media (max-width: 1399px) {
    .about {
      /* Capped so the heading's ink stays clear of the vertical wordmark on narrow tablets. */
      --touch-font-size: min(5.75rem, calc((90vw - var(--wordmark-gutter)) / var(--ink-width)));
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, min(36vw, 24rem));
      grid-template-rows: auto 1fr auto;
      grid-template-areas:
        'contact photo'
        'statement photo'
        'touch touch';
      align-content: start;
      gap: 5vw 4vw;
      height: auto;
      padding: calc(var(--header-height) + 5vw) calc(5vw + var(--wordmark-gutter)) 5vw 5vw;
    }

    .about-columns {
      display: contents;
    }

    .about-contact,
    .about-statement {
      margin: 0;
      overflow-wrap: anywhere;
    }

    .about-contact {
      grid-area: contact;
    }

    .about-statement {
      grid-area: statement;
    }

    .about-photo {
      grid-area: photo;
      height: auto;
      aspect-ratio: 395 / 647;
    }

    /* The Figma crop of the portrait. */
    .about-photo img {
      position: absolute;
      left: -29.73%;
      top: -34.4%;
      width: 174.79%;
      height: 142.52%;
      max-width: none;
    }

    /* Shifted left so the heading's ink starts at the content edge. */
    .about-touch {
      grid-area: touch;
      position: relative;
      left: auto;
      top: auto;
      width: 100%;
      margin-left: calc(-55 * var(--u));
    }
  }

  /* Tablet only: the portrait runs alongside the heading row, which starts just under the statement so the
     hand never covers text. The hand sits further left so its flat cut end is off screen. */
  @media (min-width: 768px) and (max-width: 1399px) {
    .about {
      grid-template-areas: none;
      grid-template-rows: auto auto 1fr;
    }

    .about-contact {
      grid-area: auto;
      grid-column: 1;
      grid-row: 1;
    }

    .about-statement {
      grid-area: auto;
      grid-column: 1;
      grid-row: 2;
    }

    .about-photo {
      grid-area: auto;
      grid-column: 2;
      grid-row: 1 / span 3;
      align-self: start;
    }

    .about-touch {
      grid-area: auto;
      grid-column: 1 / -1;
      grid-row: 3;
      z-index: 1;
      margin-top: calc(-5vw + 12px);
    }

    .about-hand-behind {
      left: calc(-168.68 * var(--u));
    }

    .about-hand-front {
      left: calc(-168.54 * var(--u));
    }
  }

  /* Mobile: one column with the heading above the portrait. */
  @media (max-width: 767px) {
    .about {
      --touch-font-size: 2.5rem;
      --about-text-size: 1rem;
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      grid-template-areas:
        'contact'
        'statement'
        'touch'
        'photo';
      gap: 6vw;
    }

    .about-heading {
      --wordmark-stroke-width: 1px;
    }
  }
</style>
