---
/*
|-------------------------------------------------------------------------------
| CategoryFilter — JMR Visuals Portfolio
|-------------------------------------------------------------------------------
|
| Text links matching original portfolio: "RENDERS PRINTS PHOTOGRAPHY"
| in adelle-mono, 20px, white. Sticky below header, 7% left padding.
| Border-bottom in rgba(255,255,255,0.2). Active state: underline in oxide.
|
*/
interface Props {
  categories?: string[];
  activeCategory?: string;
}

const {
  categories = ['renders', 'prints', 'photography'],
  activeCategory = 'renders',
} = Astro.props;

// Debug: log the activeCategory
// console.log('CategoryFilter activeCategory:', activeCategory);
---

<nav class="category-filter" aria-label="Filter projects by category">
  <ul class="filter-list">
    {categories.map((cat) => (
      <li>
        <a
          href={`/projects?category=${cat}`}
          aria-current={cat === activeCategory ? 'true' : undefined}
          class:list={['filter-link', cat === activeCategory && 'active']}
          data-category={cat}
        >
          {cat.toUpperCase()}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .category-filter {
    position: sticky;
    top: 60px;
    z-index: 999;
    background: #1d1f1f;
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    padding: 0;
  }

  .filter-list {
    display: flex;
    align-items: center;
    gap: 48px;
    list-style: none;
    margin: 0;
    padding: 16px 0;
    padding-left: 7%;
  }

  .filter-link {
    font-family: var(--font-mono);
    font-size: 20px;
    font-weight: 400;
    color: #ffffff;
    text-decoration: none;
    letter-spacing: 0.02em;
    padding: 8px 0;
    border-bottom: 2px solid transparent;
    transition: color var(--duration-fast) var(--ease-quick),
                border-color var(--duration-fast) var(--ease-quick);
    white-space: nowrap;
  }

  .filter-link:hover {
    color: var(--color-oxide);
  }

  .filter-link.active {
    color: #ffffff;
    border-bottom-color: var(--color-oxide);
  }

  .filter-link:focus-visible {
    outline: 2px solid var(--color-oxide);
    outline-offset: 2px;
    border-radius: 2px;
  }

  @media (max-width: 768px) {
    .filter-list {
      gap: 24px;
      padding-left: 5%;
      padding: 12px 0;
    }

    .filter-link {
      font-size: 16px;
    }
  }
</style>