---
/*
|-------------------------------------------------------------------------------
| ContactBlock — JMR Visuals Portfolio
|-------------------------------------------------------------------------------
|
| Minimal contact info: email link + ArtStation social icon.
| Dark theme matching original portfolio.
|
*/
interface Props {
  email?: string;
}

const { email = 'hello@jmrvisuals.com' } = Astro.props;
---

<section class="contact-block" aria-labelledby="contact-title">
  <h2 id="contact-title" class="contact-title">Get in Touch</h2>
  <p class="contact-text">Have a project in mind? Let's talk about it.</p>

  <div class="contact-links">
    <a href={`mailto:${email}`} class="contact-email">
      {email}
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </a>
  </div>

  <div class="contact-social" aria-label="Social links">
    <a href="https://www.artstation.com/jmr_visuals" class="social-link" aria-label="ArtStation" target="_blank" rel="noopener noreferrer">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true">
        <path d="M0 23.63l2.703 4.672c0.552 1.094 1.667 1.781 2.885 1.781h17.943l-3.724-6.453zM32 23.661c0-0.641-0.193-1.245-0.516-1.75l-10.516-18.276c-0.557-1.057-1.656-1.719-2.854-1.719h-5.557l16.24 28.135 2.563-4.432c0.5-0.849 0.641-1.224 0.641-1.958zM17.161 19.047l-7.255-12.568-7.26 12.568z"/>
      </svg>
    </a>
  </div>
</section>

<style>
  .contact-block {
    padding: var(--space-3xl) var(--space-xl);
    padding-left: calc(var(--space-xl) * 2);
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    background: #1d1f1f;
  }

  .contact-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.5rem + 3vw, 80px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0 0 var(--space-md);
    color: #ffffff;
  }

  .contact-text {
    font-family: var(--font-body);
    font-size: var(--type-base);
    line-height: var(--line-height-relaxed);
    color: rgba(255, 255, 255, 0.7);
    margin: 0 0 var(--space-xl);
    max-width: 40ch;
  }

  .contact-links {
    margin-bottom: var(--space-xl);
  }

  .contact-email {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-mono);
    font-size: 20px;
    font-weight: 400;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: #ffffff;
    transition: color var(--duration-fast) var(--ease-quick),
                gap var(--duration-fast) var(--ease-quick);
  }

  .contact-email:hover {
    color: var(--color-oxide);
    gap: var(--space-md);
  }

  .contact-social {
    display: flex;
    gap: var(--space-md);
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: #ffffff;
    opacity: 0.6;
    border-radius: 50%;
    transition: opacity var(--duration-fast) var(--ease-quick),
                color var(--duration-fast) var(--ease-quick),
                background var(--duration-fast) var(--ease-quick);
  }

  .social-link:hover {
    opacity: 1;
    color: var(--color-oxide);
    background: rgba(255, 255, 255, 0.05);
  }

  @media (max-width: 768px) {
    .contact-block {
      padding: var(--space-2xl) var(--space-md);
      padding-left: var(--space-md);
    }

    .contact-title {
      font-size: clamp(1.5rem, 1rem + 3vw, 50px);
    }
  }
</style>
