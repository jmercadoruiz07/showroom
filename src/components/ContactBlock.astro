---
/*
|-------------------------------------------------------------------------------
| ContactBlock — JMR Visuals Portfolio
|-------------------------------------------------------------------------------
|
| Two columns under the GET IN TOUCH rule, on the same grid as the About text
| columns (--u is one pixel of the 1702px Figma frame): contact links on the
| left, a closing statement on the right. Stacks below 768px.
|
*/
interface Props {
  email?: string;
  statement: string;
}

const { email = 'hello@jmrvisuals.com', statement } = Astro.props;
---

<section class="contact-block" aria-label="Contact">
  <div class="contact-details">
    <p class="contact-text">Have a project in mind? Let's talk about it.</p>

    <a href={`mailto:${email}`} class="contact-email">
      {email}
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </a>

    <div class="contact-social" aria-label="Social links">
      <a href="https://www.artstation.com/jmr_visuals" class="social-link" aria-label="ArtStation" target="_blank" rel="noopener noreferrer">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M0 17.723l2.027 3.505h.001a2.424 2.424 0 0 0 2.164 1.333h13.457l-2.792-4.838H0zm24-.027L21.973 13.5H8.352l2.028 3.505h13.457zM15.495 9.662l-2.028-3.505h-7.3L8.135 9.662h7.36zm-5.328-5.85L8.136 7.316l-2.028-3.505L0 17.73l2.027 3.505h17.946l2.027-3.505-6.833-11.72z"/>
        </svg>
      </a>
      <a href="https://www.instagram.com" class="social-link" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
        </svg>
      </a>
      <a href="https://www.linkedin.com" class="social-link" aria-label="LinkedIn" target="_blank" rel="noopener noreferrer">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
      </a>
    </div>
  </div>

  <p class="contact-statement">{statement}</p>
</section>

<style>
  .contact-block {
    --u: calc(100vw / 1702);
    display: grid;
    grid-template-columns: calc(275 * var(--u)) calc(447 * var(--u));
    column-gap: calc(61 * var(--u));
    align-items: start;
    padding: calc(60 * var(--u)) 0 calc(140 * var(--u)) calc(212 * var(--u));
    font-family: var(--font-hero-mono);
    font-size: max(0.875rem, calc(23.458 * var(--u)));
    line-height: 1.255;
  }

  .contact-text,
  .contact-statement {
    margin: 0;
    max-width: none;
  }

  .contact-text {
    margin-bottom: var(--space-md);
  }

  .contact-email {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: 0.85em;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    transition: color var(--duration-fast) var(--ease-quick),
                gap var(--duration-fast) var(--ease-quick);
  }

  .contact-email:hover {
    color: var(--color-accent);
    gap: var(--space-md);
  }

  .contact-social {
    display: flex;
    gap: var(--space-xs);
    margin-top: var(--space-md);
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    transition: color var(--duration-fast) var(--ease-quick);
  }

  .social-link:hover {
    color: var(--color-accent);
  }

  @media (max-width: 767px) {
    .contact-block {
      grid-template-columns: 1fr;
      row-gap: 6vw;
      padding: 8vw 6vw 12vw;
      font-size: max(0.875rem, 3.8vw);
    }
  }
</style>
