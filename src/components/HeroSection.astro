---
/*
|-------------------------------------------------------------------------------
| HeroSection — JMR Visuals Portfolio
|-------------------------------------------------------------------------------
|
| Full viewport (100vw × 100vh) hero matching original portfolio.
| Slideshow background with "JO SE" massive title bottom-left.
| Vertical rotated "MERCADO_RUIZ" on right edge.
| No subtitle, no scroll indicator, no background color blocks.
|
*/
import HeroCarousel, { type HeroSlide } from './HeroCarousel';

interface Props {
  slides?: HeroSlide[];
}

const {
  slides,
} = Astro.props;

const hasSlides = slides !== undefined && slides.length > 0;
---

<section class="hero" aria-labelledby="hero-title">
  {hasSlides ? (
    <HeroCarousel slides={slides} client:load />
  ) : (
    <div class="hero-background" aria-hidden="true">
      <img
        src="/hero-default.jpg"
        alt="Portfolio hero image"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  )}

  <div class="hero-content">
    <h1 id="hero-title" class="hero-title">
      JO<br/>SE
    </h1>
    <div class="vertical-name" aria-hidden="true">
      <span>.........MERCADO_RUIZ</span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100vw;
    height: 100vh;
    min-height: 600px;
    margin-left: calc(50% - 50vw);
    overflow: hidden;
  }

  .hero-background {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero-background img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 0;
    padding-left: 7%;
    padding-bottom: 5%;
    color: #ffffff;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(4rem, 3rem + 8vw, 530px);
    font-weight: 700;
    line-height: clamp(3rem, 2rem + 6vw, 378px);
    letter-spacing: clamp(-20px, -3vw, -62.9px);
    margin: 0;
    color: #ffffff;
    text-transform: uppercase;
  }

  .vertical-name {
    position: absolute;
    right: 7%;
    bottom: 5%;
    transform: rotate(-90deg);
    transform-origin: bottom right;
    z-index: 2;
  }

  .vertical-name span {
    font-family: var(--font-display);
    font-size: var(--type-vertical-name);
    font-weight: 400;
    line-height: 1;
    color: #ffffff;
    white-space: nowrap;
    letter-spacing: 0.02em;
  }

  @media (max-width: 768px) {
    .hero {
      height: 100vh;
      min-height: 500px;
    }

    .hero-content {
      padding-left: 5%;
      padding-bottom: 5%;
    }

    .vertical-name {
      right: 5%;
      bottom: 5%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    /* No animations to reduce */
  }
</style>