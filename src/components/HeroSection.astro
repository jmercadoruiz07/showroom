---
/*
|-------------------------------------------------------------------------------
| HeroSection — JMR Visuals Portfolio
|-------------------------------------------------------------------------------
|
| Full-window hero: a rotating project image behind the name.
|
*/
import HeroCarousel, { type HeroSlide } from './HeroCarousel/HeroCarousel';

interface Props {
  slides: HeroSlide[];
}

const { slides } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <HeroCarousel slides={slides} client:load />

  <h1 id="hero-title" class="hero-name">
    <span aria-hidden="true"><span class="hero-name-line">JO</span><span class="hero-name-line">SE</span></span>
    <span class="visually-hidden">José Mercado Ruiz</span>
  </h1>
</section>

<style>
  .hero {
    position: relative;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    background: var(--color-bone);
    color: var(--color-chalk);
  }

  /* Darkens the top edge so the transparent nav stays legible over bright images. */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: calc(var(--header-height) * 2.5);
    background: linear-gradient(to bottom, rgb(0 0 0 / 0.35), transparent);
    pointer-events: none;
  }

  /* Sized from the window height so both lines fill most of it; clicks fall through to the project link. */
  .hero-name {
    position: absolute;
    left: -0.02em;
    bottom: 9vh;
    z-index: 1;
    margin: 0;
    font-family: var(--font-hero);
    font-size: min(50vh, 40vw);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.1em;
    line-height: 0.78;
    text-transform: uppercase;
    white-space: pre;
    color: inherit;
    pointer-events: none;
  }

  .hero-name-line {
    display: block;
  }

  @media (max-width: 767px) {
    .hero {
      height: 70vh;
      height: 70svh;
    }

    .hero-name {
      bottom: 4vh;
      left: 3vw;
      font-size: 40vw;
    }

    .hero-name-line {
      display: inline;
    }
  }
</style>
