---
/*
|-------------------------------------------------------------------------------
| HeroSection — JMR Visuals Portfolio
|-------------------------------------------------------------------------------
|
| Full-window hero: a rotating background image behind the name.
|
*/
import HeroCarousel from './HeroCarousel/HeroCarousel';

interface Props {
  images: string[];
}

const { images } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <HeroCarousel images={images} client:load />

  <h1 id="hero-title" class="hero-name">
    <span aria-hidden="true"><span class="hero-name-line">JO</span><span class="hero-name-line">SE</span></span>
    <span class="visually-hidden">José Mercado Ruiz</span>
  </h1>

  <a class="hero-scroll" href="#main-content" aria-label="Scroll to projects">
    <svg class="hero-scroll-chevron" viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M6 9l6 6 6-6" />
    </svg>
  </a>
</section>

<style>
  .hero {
    position: relative;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    background: var(--color-bone);
    color: var(--color-chalk);
  }

  /* Sized from the window height so both lines fill most of it; clicks fall through to the project link. */
  .hero-name {
    position: absolute;
    left: -0.02em;
    bottom: 9vh;
    z-index: 1;
    margin: 0;
    font-family: var(--font-hero);
    font-size: min(50vh, 40vw);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.1em;
    line-height: 0.78;
    text-transform: uppercase;
    white-space: pre;
    color: inherit;
    pointer-events: none;
  }

  .hero-name-line {
    display: block;
  }

  .hero-scroll {
    position: absolute;
    left: 50%;
    bottom: 2.5rem;
    z-index: 1;
    transform: translateX(-50%);
    color: var(--color-chalk);
  }

  .hero-scroll:focus-visible {
    outline: 2px solid var(--color-chalk);
    outline-offset: 4px;
  }

  .hero-scroll-chevron {
    filter: drop-shadow(0 1px 8px rgb(0 0 0 / 0.5));
    animation: hero-scroll-bob 1.8s var(--ease-standard) infinite;
  }

  @keyframes hero-scroll-bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(0.4rem); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-scroll-chevron {
      animation: none;
    }
  }

  @media (max-width: 767px) {
    .hero {
      height: 70vh;
      height: 70svh;
    }

    .hero-name {
      bottom: 4vh;
      left: 3vw;
      font-size: 40vw;
    }

    .hero-name-line {
      display: inline;
    }

    .hero-scroll {
      display: none;
    }
  }
</style>
