---
/*
|-------------------------------------------------------------------------------
| OutlinedWordmark — JMR Visuals Portfolio
|-------------------------------------------------------------------------------
|
| Text drawn as outlined letters; hovering a letter fills it, and with
| fillNeighbours the letters either side of it fill too. kerns adds extra space
| (em) after a letter, indexed over the letters skipping spaces. Each letter is
| generated content because real text would be repainted by a page text
| selection and disappear. The parent supplies a class that positions and sizes
| it (font-size, line-height, writing mode), styled with :global since scoped
| styles do not reach this component's root, and may set --wordmark-stroke-width
| and --wordmark-gap (the space between words).
|
*/
interface Props {
  text: string;
  fillNeighbours?: boolean;
  kerns?: number[];
  class?: string;
}

const { text, fillNeighbours = false, kerns = [], class: className } = Astro.props;

// Spaces become a gap before the next letter so "adjacent" always means a visible letter.
const letters: { char: string; gap: boolean; kern: number }[] = [];
let gap = false;
for (const char of text) {
  if (char === ' ') {
    gap = true;
    continue;
  }
  letters.push({ char, gap, kern: kerns[letters.length] ?? 0 });
  gap = false;
}
---

<p class:list={['outlined-wordmark', { 'fills-neighbours': fillNeighbours }, className]} aria-hidden="true">
  {letters.map(({ char, gap, kern }) => (
    <span
      class:list={['letter', { 'has-gap': gap }]}
      data-char={char}
      style={kern ? `margin-inline-end: ${kern}em` : undefined}
    ></span>
  ))}
</p>

<style>
  .outlined-wordmark {
    margin: 0;
    max-width: none;
    font-family: var(--font-hero);
    font-weight: var(--font-weight-black);
    text-transform: uppercase;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: var(--wordmark-stroke-width, 1.5px) var(--color-chalk);
    pointer-events: none;
    user-select: none;
  }

  .letter::before {
    content: attr(data-char);
  }

  .letter {
    pointer-events: auto;
    transition: color var(--duration-base) var(--ease-standard);
  }

  .has-gap {
    margin-inline-start: var(--wordmark-gap, 0.25em);
  }

  .letter:hover,
  .fills-neighbours .letter:hover + .letter,
  .fills-neighbours .letter:has(+ .letter:hover) {
    color: var(--color-chalk);
  }

  @media (prefers-reduced-motion: reduce) {
    .letter {
      transition: none;
    }
  }
</style>
