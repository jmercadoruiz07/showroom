---
/**
 * Loads and sorts the projects, derives the album list and renders the album-filtered grid.
 * With `featuredPicks` the first tab is FEATURED and shows those projects in an accordion.
 */

import { getCollection } from 'astro:content';
import ProjectGallery from './ProjectGallery/ProjectGallery';
import { sortProjectsByOrder } from '../utils/sort-projects';
import { pageUrl } from '../utils/asset-url';
import { firstImage, imageAssets } from '../utils/project-media';

type FeaturedPick = {
  id: string;
  /** Zero-based position among the project's image assets (videos not counted); falls back to 0 when out of range. */
  imageIndex: number;
};

type AlbumTabOrder = 'recent' | 'projectCount' | 'alphabetical';

type Props = {
  tightTop?: boolean;
  stickyFilter?: boolean;
  featuredPicks?: FeaturedPick[];
  /** Order of the album tabs after the first (ALL / FEATURED) tab: newest project first, most projects first, or A to Z. */
  albumTabOrder?: AlbumTabOrder;
};

const { tightTop = false, stickyFilter = true, featuredPicks, albumTabOrder = 'projectCount' } = Astro.props;

const allProjects = await getCollection('projects', ({ data }) => !data.featured);
const featuredProjects = await getCollection('projects', ({ data }) => data.featured);

/** Sorted by order, then date. */
const sortedProjects = sortProjectsByOrder([...featuredProjects, ...allProjects]);

const projects = sortedProjects.map((project) => ({
  title: project.data.title,
  album: project.data.albums?.[0] ?? '',
  /** The card shows the project's first image asset; the ArtStation cover is only a fallback. */
  thumbnail: (({ url, width, height }) => ({ url, width, height }))(
    firstImage(project.data.media) ?? project.data.thumbnail,
  ),
  thumbnailAlt: `${project.data.title} thumbnail`,
  href: pageUrl(`/works/${project.id}`),
  featured: project.data.featured,
}));

const projectCounts = new Map<string, number>();
for (const { album } of projects) {
  if (album) projectCounts.set(album, (projectCounts.get(album) ?? 0) + 1);
}

/** Date of each album's newest project. */
const latestDates = new Map<string, number>();
for (const project of sortedProjects) {
  const album = project.data.albums?.[0];
  if (!album) continue;
  latestDates.set(album, Math.max(latestDates.get(album) ?? 0, project.data.date.getTime()));
}

const albumComparators: Record<AlbumTabOrder, (a: string, b: string) => number> = {
  recent: (a, b) => latestDates.get(b)! - latestDates.get(a)!,
  projectCount: (a, b) => projectCounts.get(b)! - projectCounts.get(a)!,
  alphabetical: (a, b) => a.localeCompare(b),
};

/** Ties keep the order in which each album first appears. */
const albums = [...projectCounts.keys()].sort(albumComparators[albumTabOrder]);

const featured = featuredPicks?.map(({ id, imageIndex }) => {
  const project = sortedProjects.find((p) => p.id === id);
  if (!project) {
    throw new Error(`Featured project "${id}" is not in projects.json. Update featuredPicks to an existing project id.`);
  }
  const images = imageAssets(project.data.media);
  const image = images[imageIndex] ?? images[0] ?? project.data.thumbnail;
  const pickedIndex = images[imageIndex] ? imageIndex : 0;
  return {
    title: project.data.title,
    album: project.data.albums?.[0] ?? '',
    thumbnail: { url: image.url, width: image.width, height: image.height },
    thumbnailAlt: `${project.data.title} featured image`,
    /** Every image asset, so the open strip can step through them. */
    images: images.map(({ url, width, height }) => ({ url, width, height })),
    imageIndex: pickedIndex,
    href: pageUrl(`/works/${project.id}`),
    featured: project.data.featured,
  };
});
---

<ProjectGallery projects={projects} albums={albums} featured={featured} tightTop={tightTop} stickyFilter={stickyFilter} client:load />
