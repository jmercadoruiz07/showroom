---
/*
|-------------------------------------------------------------------------------
| ProjectGallery — JMR Visuals Portfolio
|-------------------------------------------------------------------------------
|
| Loads project content, sorts by order/date, derives the unique album list,
| and renders the interactive album-filtered grid as a React island. When
| `featuredPicks` is given, the first tab is FEATURED and shows those projects,
| each with the chosen image, in an accordion.
|
*/
import { getCollection } from 'astro:content';
import ProjectGallery from './ProjectGallery/ProjectGallery';
import { sortProjectsByOrder } from '../utils/sort-projects';
import { pageUrl } from '../utils/asset-url';

interface FeaturedPick {
  id: string;
  /** Zero-based position in the project's images; falls back to 0 when out of range. */
  imageIndex: number;
}

interface Props {
  tightTop?: boolean;
  stickyFilter?: boolean;
  featuredPicks?: FeaturedPick[];
}

const { tightTop = false, stickyFilter = true, featuredPicks } = Astro.props;

const allProjects = await getCollection('projects', ({ data }) => !data.featured);
const featuredProjects = await getCollection('projects', ({ data }) => data.featured);

// Sort by order, then date
const sortedProjects = sortProjectsByOrder([...featuredProjects, ...allProjects]);

const projects = sortedProjects.map((project) => ({
  title: project.data.title,
  album: project.data.albums?.[0] ?? '',
  thumbnail: {
    url: project.data.thumbnail.url,
    width: project.data.thumbnail.width,
    height: project.data.thumbnail.height,
  },
  thumbnailAlt: `${project.data.title} thumbnail`,
  href: pageUrl(`/works/${project.id}`),
  featured: project.data.featured,
}));

// Derive the unique album list from the loaded projects, preserving the
// order each album first appears so the filter pills stay stable across
// re-runs of the scraper.
const albums = Array.from(
  new Set(projects.map((project) => project.album).filter((a) => a.length > 0)),
);

const featured = featuredPicks?.map(({ id, imageIndex }) => {
  const project = sortedProjects.find((p) => p.id === id);
  if (!project) {
    throw new Error(`Featured project "${id}" is not in projects.json. Update featuredPicks to an existing project id.`);
  }
  const { images, thumbnail } = project.data;
  const image = images[imageIndex] ?? images[0] ?? thumbnail;
  return {
    title: project.data.title,
    album: project.data.albums?.[0] ?? '',
    thumbnail: { url: image.url, width: image.width, height: image.height },
    thumbnailAlt: `${project.data.title} featured image`,
    href: pageUrl(`/works/${project.id}`),
    featured: project.data.featured,
  };
});
---

<ProjectGallery projects={projects} albums={albums} featured={featured} tightTop={tightTop} stickyFilter={stickyFilter} client:load />
