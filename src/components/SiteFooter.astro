---
/*
|-------------------------------------------------------------------------------
| SiteFooter — JMR Visuals Portfolio
|-------------------------------------------------------------------------------
|
| White hairline, a bar with the copyright and social link, and an outlined
| wordmark that fills the footer width between equal side insets. The footer
| is a size container so the wordmark scales with its own width, not the page's.
|
*/
---

<footer class="site-footer" role="contentinfo">
  <div class="footer-bar">
    <p class="copyright">
      &copy; {new Date().getFullYear()} JMR Visuals. All rights reserved.
    </p>

    <a href="https://www.artstation.com/jmr_visuals" class="social-link" aria-label="ArtStation" target="_blank" rel="noopener noreferrer">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true">
        <path d="M0 23.63l2.703 4.672c0.552 1.094 1.667 1.781 2.885 1.781h17.943l-3.724-6.453zM32 23.661c0-0.641-0.193-1.245-0.516-1.75l-10.516-18.276c-0.557-1.057-1.656-1.719-2.854-1.719h-5.557l16.24 28.135 2.563-4.432c0.5-0.849 0.641-1.224 0.641-1.958zM17.161 19.047l-7.255-12.568-7.26 12.568z"/>
      </svg>
    </a>
  </div>

  <p class="footer-wordmark" aria-hidden="true">José</p>
</footer>

<style>
  .site-footer {
    --footer-inset: var(--space-lg);
    container-type: inline-size;
    background: var(--color-bone);
    border-top: 1px solid var(--color-chalk);
  }

  .footer-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding: var(--space-sm) var(--footer-inset);
  }

  .copyright {
    margin: 0;
    max-width: none;
    font-size: var(--type-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: var(--color-ink);
    transition: color var(--duration-fast) var(--ease-quick);
  }

  .social-link:hover {
    color: var(--color-accent);
  }

  /* 2.402 is the ink width of JOSÉ in em at this letter-spacing, so the text spans the insets exactly.
     The box is trimmed to cap height and baseline; the top padding leaves room for the accent, and the round
     letters' overshoot below the baseline bleeds off the page. Clipping stops the font's descender area adding scroll height. */
  .footer-wordmark {
    margin: 0;
    max-width: none;
    padding: 0.235em var(--footer-inset) 1px;
    overflow: hidden;
    font-family: var(--font-hero);
    font-size: calc((100cqw - 2 * var(--footer-inset)) / 2.402);
    font-weight: var(--font-weight-black);
    letter-spacing: -0.04em;
    line-height: 0.92;
    text-box: trim-both cap alphabetic;
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 2px var(--color-chalk);
    user-select: none;
  }

  @media (max-width: 768px) {
    .site-footer {
      --footer-inset: var(--space-md);
    }

    .footer-wordmark {
      -webkit-text-stroke-width: 1px;
    }
  }
</style>
