---
/*
|-------------------------------------------------------------------------------
| SiteFooter — JMR Visuals Portfolio
|-------------------------------------------------------------------------------
|
| Minimal dark footer matching original portfolio.
| Centered mono text, ArtStation link only.
|
*/
---

<footer class="site-footer" role="contentinfo">
  <div class="footer-inner">
    <p class="copyright">
      &copy; {new Date().getFullYear()} JMR Visuals. All rights reserved.
    </p>
    <div class="footer-social">
      <a href="https://www.artstation.com/jmr_visuals" class="social-link" aria-label="ArtStation" target="_blank" rel="noopener noreferrer">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true">
          <path d="M0 23.63l2.703 4.672c0.552 1.094 1.667 1.781 2.885 1.781h17.943l-3.724-6.453zM32 23.661c0-0.641-0.193-1.245-0.516-1.75l-10.516-18.276c-0.557-1.057-1.656-1.719-2.854-1.719h-5.557l16.24 28.135 2.563-4.432c0.5-0.849 0.641-1.224 0.641-1.958zM17.161 19.047l-7.255-12.568-7.26 12.568z"/>
        </svg>
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #1d1f1f;
    color: rgba(255, 255, 255, 0.5);
    padding: var(--space-lg) var(--space-xl);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .footer-inner {
    max-width: var(--max-width-full);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-xl);
  }

  .copyright {
    font-family: var(--font-mono);
    font-size: var(--type-xs);
    color: rgba(255, 255, 255, 0.5);
    margin: 0;
  }

  .footer-social {
    display: flex;
    gap: var(--space-md);
    align-items: center;
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: rgba(255, 255, 255, 0.5);
    opacity: 0.6;
    border-radius: 50%;
    transition: opacity var(--duration-fast) var(--ease-quick),
                color var(--duration-fast) var(--ease-quick),
                background var(--duration-fast) var(--ease-quick);
  }

  .social-link:hover {
    opacity: 1;
    color: var(--color-oxide);
    background: rgba(255, 255, 255, 0.05);
  }

  @media (max-width: 768px) {
    .site-footer {
      padding: var(--space-xl) var(--space-md);
    }

    .footer-inner {
      flex-direction: column;
      gap: var(--space-md);
      text-align: center;
    }

    .footer-social {
      justify-content: center;
    }
  }
</style>