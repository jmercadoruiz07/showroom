---
/*
|-------------------------------------------------------------------------------
| SiteFooter — JMR Visuals Portfolio
|-------------------------------------------------------------------------------
|
| White hairline, a bar with the copyright and social links, and an outlined
| wordmark that fills the footer width between equal side insets; hovering a
| letter fills just that letter. The footer is a size container so the wordmark
| scales with its own width, not the page's.
|
*/
import OutlinedWordmark from './OutlinedWordmark.astro';
---

<footer class="site-footer" role="contentinfo">
  <div class="footer-bar">
    <p class="copyright">
      &copy; {new Date().getFullYear()} JMR Visuals. All rights reserved.
    </p>

    <div class="social-links">
      <a href="https://www.instagram.com/j.art_47/" class="social-link" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="2 2 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="5" />
          <circle cx="12" cy="12" r="4" />
          <circle cx="17.5" cy="6.5" r="0.75" fill="currentColor" stroke="none" />
        </svg>
      </a>

      <a href="https://www.artstation.com/jmr_visuals" class="social-link" aria-label="ArtStation" target="_blank" rel="noopener noreferrer">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true">
          <path d="M0 23.63l2.703 4.672c0.552 1.094 1.667 1.781 2.885 1.781h17.943l-3.724-6.453zM32 23.661c0-0.641-0.193-1.245-0.516-1.75l-10.516-18.276c-0.557-1.057-1.656-1.719-2.854-1.719h-5.557l16.24 28.135 2.563-4.432c0.5-0.849 0.641-1.224 0.641-1.958zM17.161 19.047l-7.255-12.568-7.26 12.568z"/>
        </svg>
      </a>
    </div>
  </div>

  <OutlinedWordmark class="footer-wordmark" text="Jose" />
</footer>

<style>
  .site-footer {
    --footer-inset: var(--space-lg);
    container-type: inline-size;
    background: var(--color-bone);
  }

  .site-footer::before {
    content: '';
    display: block;
    margin-inline: var(--grid-gutter);
    border-top: 1px solid var(--color-chalk);
  }

  .footer-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding: var(--space-sm) var(--grid-gutter);
  }

  .copyright {
    margin: 0;
    max-width: none;
    font-size: var(--type-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .social-links {
    display: flex;
    align-items: center;
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: var(--color-ink);
    transition: color var(--duration-fast) var(--ease-quick);
  }

  .social-link:hover {
    color: var(--color-accent);
  }

  /* 2.402 is the ink width of JOSE in em at this letter-spacing, so the text spans the insets exactly.
     The box is trimmed to cap height and baseline; the top and bottom padding cover the round letters'
     overshoot (0.016em) and the outline stroke. Clipping stops the font's descender area adding scroll height. */
  .site-footer :global(.footer-wordmark) {
    --wordmark-stroke-width: 2px;
    padding: calc(0.016em + 3px) var(--footer-inset);
    overflow: hidden;
    font-size: calc((100cqw - 2 * var(--footer-inset)) / 2.402);
    letter-spacing: -0.04em;
    line-height: 0.92;
    text-box: trim-both cap alphabetic;
    text-align: center;
  }

  @media (max-width: 768px) {
    .site-footer {
      --footer-inset: var(--space-md);
    }

    .site-footer :global(.footer-wordmark) {
      --wordmark-stroke-width: 1px;
    }
  }
</style>
