---
/*
|-------------------------------------------------------------------------------
| SiteHeader — JMR Visuals Portfolio
|-------------------------------------------------------------------------------
|
| Fixed white navigation bar across the top, above all page content. While a
| .hero section is in view it turns transparent with white links.
|
*/
const pathname = Astro.url.pathname;

const links = [
  { href: '/', label: 'Home' },
  { href: '/projects', label: 'Projects' },
  { href: '/about', label: 'About' },
];

const isCurrent = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header class="site-header" role="banner">
  <nav class="nav-primary" aria-label="Primary navigation">
    <ul class="nav-list">
      {links.map(({ href, label }) => (
        <li>
          <a href={href} class="nav-link" aria-current={isCurrent(href) ? 'page' : undefined}>
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  let observer: IntersectionObserver | undefined;

  function watchHero() {
    observer?.disconnect();

    const header = document.querySelector<HTMLElement>('.site-header');
    const hero = document.querySelector('.hero');
    if (!header) return;

    header.toggleAttribute('data-over-hero', hero !== null);
    if (!hero) return;

    // Shrinking the viewport by the header height flips the nav once the hero scrolls beneath it.
    observer = new IntersectionObserver(
      ([entry]) => header.toggleAttribute('data-over-hero', entry.isIntersecting),
      { rootMargin: `-${header.offsetHeight}px 0px 0px 0px` },
    );
    observer.observe(hero);
  }

  document.addEventListener('astro:page-load', watchHero);
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--header-height);
    z-index: var(--z-header);
    pointer-events: none;
  }

  .nav-primary {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: var(--color-chalk);
    pointer-events: auto;
    transition: background-color var(--duration-base) var(--ease-standard);
  }

  .site-header[data-over-hero] .nav-primary {
    background: transparent;
  }

  .nav-list {
    --nav-font-size: var(--type-xs);
    display: flex;
    align-items: center;
    gap: 2.5vw;
    height: 100%;
    margin: 0;
    /* Page gutter plus the gallery tab's inner padding, so links share the tab labels' left edge. */
    padding: 0 0 0 calc(var(--space-xl) + 0.7 * var(--nav-font-size));
    list-style: none;
  }

  .nav-list li {
    margin: 0;
  }

  .nav-link {
    display: inline-block;
    padding-top: 0.18em;
    font-family: var(--font-hero-mono);
    font-size: var(--nav-font-size);
    font-weight: var(--font-weight-regular);
    letter-spacing: var(--tracking-wide);
    line-height: 1;
    text-transform: uppercase;
    color: var(--color-bone);
    transition: color var(--duration-fast) var(--ease-quick);
  }

  .nav-link:hover,
  .nav-link[aria-current='page'] {
    color: var(--color-accent);
  }

  .nav-link:focus-visible {
    outline: 2px solid var(--color-bone);
    outline-offset: 4px;
  }

  .site-header[data-over-hero] .nav-link {
    color: var(--color-chalk);
    text-shadow: 0 1px 12px rgb(0 0 0 / 0.35);
  }

  .site-header[data-over-hero] .nav-link[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .site-header[data-over-hero] .nav-link:focus-visible {
    outline-color: var(--color-chalk);
  }

  @media (max-width: 767px) {
    .nav-list {
      gap: 6vw;
      padding-left: calc(var(--space-md) + 0.7 * var(--nav-font-size));
    }
  }
</style>
