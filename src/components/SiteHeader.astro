---
/*
|-------------------------------------------------------------------------------
| SiteHeader — JMR Visuals Portfolio
|-------------------------------------------------------------------------------
|
| Fixed position header matching original portfolio.
| Solid dark background, adelle-mono navigation, left padding 117px.
| No theme toggle (original is dark-only).
|
*/
---

<header class="site-header" role="banner">
  <div class="header-inner">
    <nav class="nav-primary" aria-label="Primary navigation">
      <ul class="nav-list">
        <li><a href="/" class="nav-link">PROJECTS</a></li>
        <li><a href="/about" class="nav-link">ABOUT</a></li>
        <li><a href="/contact" class="nav-link">CONTACT</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 60px;
    min-height: 6vh;
    z-index: 1000;
    background: #1d1f1f;
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
  }

  .header-inner {
    display: flex;
    align-items: center;
    height: 100%;
    max-width: 100%;
    margin: 0 auto;
    padding-left: 117px;
  }

  .nav-primary {
    width: 100%;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 48px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    font-family: var(--font-mono);
    font-size: 20px;
    font-weight: 400;
    color: #ffffff;
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: color var(--duration-fast) var(--ease-quick);
  }

  .nav-link:hover {
    color: var(--color-oxide);
  }

  @media (max-width: 768px) {
    .header-inner {
      padding-left: 24px;
    }

    .nav-list {
      gap: 24px;
    }

    .nav-link {
      font-size: 16px;
    }
  }
</style>