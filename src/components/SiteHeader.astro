---
/**
 * Fixed navigation bar. On pages with a `.hero` it is transparent at the top and fills in once the page scrolls.
 */

import { pageUrl } from '../utils/asset-url';

const trimSlash = (path: string) => path.replace(/\/$/, '');
const pathname = trimSlash(Astro.url.pathname);

const links = [
  { href: pageUrl('/'), label: 'Home' },
  { href: pageUrl('/works'), label: 'Works' },
  { href: pageUrl('/about'), label: 'About' },
];

/** The home page opens with the links over the hero and a JMR label; both are driven by `data-intro`. */
const hasIntro = pathname === trimSlash(pageUrl('/'));

const isCurrent = (href: string) =>
  href === pageUrl('/') ? pathname === trimSlash(href) : pathname.startsWith(href);
---

<header class="site-header" role="banner" data-intro={hasIntro ? '' : undefined}>
  <nav class="nav-primary" aria-label="Primary navigation">
    <ul class="nav-list">
      {links.map(({ href, label }) => (
        <li>
          <a href={href} class="nav-link" aria-current={isCurrent(href) ? 'page' : undefined}>
            {label}
          </a>
        </li>
      ))}
    </ul>
    {hasIntro && <span class="nav-label">JMR</span>}
  </nav>
</header>

<script>
  let onScroll: (() => void) | undefined;

  function watchScroll() {
    if (onScroll) window.removeEventListener('scroll', onScroll);
    onScroll = undefined;

    const header = document.querySelector<HTMLElement>('.site-header');
    const hasHero = document.querySelector('.hero') !== null;
    if (!header) return;

    header.toggleAttribute('data-hero', hasHero);
    if (!hasHero) return;

    onScroll = () => header.toggleAttribute('data-scrolled', window.scrollY > 0);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  document.addEventListener('astro:page-load', watchScroll);
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--header-height);
    z-index: var(--z-header);
    pointer-events: none;
  }

  .nav-primary {
    --nav-font-size: var(--type-xs);
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: var(--color-bone);
    pointer-events: auto;
    transition: background-color var(--duration-base) var(--ease-standard);
  }

  .site-header[data-hero]:not([data-scrolled]) .nav-primary {
    background: transparent;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 2.5vw;
    height: 100%;
    margin: 0;
    /* Page gutter plus the gallery tab's inner padding, so links share the tab labels' left edge. */
    padding: 0 0 0 calc(var(--space-xl) + 0.7 * var(--nav-font-size));
    list-style: none;
    transition: transform var(--duration-slow) var(--ease-standard);
  }

  /* The intro state: at the top of a page that has one, --intro is 1 and everything keyed to it is shown or
     shifted; scrolling clears it and the transitions below run back. */
  .site-header[data-intro]:not([data-scrolled]) {
    --intro: 1;
  }

  /* The links sit over the hero, with the H's stem under the J of JOSE. The J's stem starts 0.2125em into its
     glyph and the hero name is offset by -0.02em, both in the hero's font size; the H's ink starts 0.08em
     into its glyph. The shift is the move from the usual left edge to that stem, plus a 4px nudge to the right. */
  @media (min-width: 768px) {
    .nav-list {
      transform: translateX(
        calc(
          var(--intro, 0) *
            (0.1925 * var(--hero-name-size) - var(--space-xl) - 0.78 * var(--nav-font-size) + 4px)
        )
      );
    }
  }

  /* A plain label at the right end of the bar (768px and up), its right edge in line with the vertical wordmark's. The
     trailing letter-spacing is pulled back so the J-M-R ink ends at that edge. */
  .nav-label {
    position: absolute;
    top: 50%;
    right: var(--wordmark-inset);
    margin-right: calc(-1 * var(--tracking-wide) * 1em);
    transform: translateY(-50%);
    font-family: var(--font-hero-mono);
    font-size: var(--nav-font-size);
    letter-spacing: var(--tracking-wide);
    line-height: 1;
    text-transform: uppercase;
    color: var(--color-chalk);
    opacity: var(--intro, 0);
    transition: opacity var(--duration-slow) var(--ease-standard);
    pointer-events: none;
    user-select: none;
  }

  .nav-list li {
    margin: 0;
  }

  .nav-link {
    display: inline-block;
    padding: 0.3em 0;
    font-family: var(--font-hero-mono);
    font-size: var(--nav-font-size);
    font-weight: var(--font-weight-regular);
    letter-spacing: var(--tracking-wide);
    line-height: 1;
    text-transform: uppercase;
    color: var(--color-chalk);
    /* The underline is a background that grows from the left edge. */
    background: linear-gradient(currentColor, currentColor) no-repeat 0 100% / 0 1px;
    transition: background-size var(--duration-base) var(--ease-standard);
  }

  .nav-link:hover,
  .nav-link:focus-visible,
  .nav-link[aria-current='page'] {
    background-size: 100% 1px;
  }

  .nav-link:focus-visible {
    outline: 2px solid var(--color-chalk);
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-link,
    .nav-list,
    .nav-label {
      transition: none;
    }
  }

  @media (max-width: 767px) {
    .nav-list {
      gap: 6vw;
      padding-left: calc(var(--space-md) + 0.7 * var(--nav-font-size));
    }

    .nav-label {
      display: none;
    }
  }
</style>
