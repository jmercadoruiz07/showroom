---
/*
|-------------------------------------------------------------------------------
| SiteHeader — JMR Visuals Portfolio
|-------------------------------------------------------------------------------
|
| Fixed white navigation bar across the top. A notch on the right leaves room
| for the vertical title on the home page; below 768px the bar is one piece.
|
*/
const pathname = Astro.url.pathname;

const links = [
  { href: '/', label: 'Home' },
  { href: '/projects', label: 'Projects' },
  { href: '/about', label: 'About' },
];

const isCurrent = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header class="site-header" role="banner">
  <nav class="nav-primary" aria-label="Primary navigation">
    <ul class="nav-list">
      {links.map(({ href, label }) => (
        <li>
          <a href={href} class="nav-link" aria-current={isCurrent(href) ? 'page' : undefined}>
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <div class="nav-bar-end" aria-hidden="true"></div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--header-height);
    z-index: var(--z-header);
    pointer-events: none;
  }

  .nav-primary,
  .nav-bar-end {
    position: absolute;
    top: 0;
    height: 100%;
    background: var(--color-chalk);
  }

  .nav-primary {
    left: 0;
    width: 85.1%;
    pointer-events: auto;
  }

  .nav-bar-end {
    left: 93%;
    right: 0;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 2.5vw;
    height: 100%;
    margin: 0;
    padding: 0 0 0 15%;
    list-style: none;
  }

  .nav-list li {
    margin: 0;
  }

  .nav-link {
    display: inline-block;
    padding-top: 0.18em;
    font-family: var(--font-hero);
    font-size: clamp(0.875rem, 1.75vw, 1.75rem);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-tight);
    line-height: 1;
    text-transform: uppercase;
    color: var(--color-bone);
    transition: color var(--duration-fast) var(--ease-quick);
  }

  .nav-link:hover,
  .nav-link[aria-current='page'] {
    color: var(--color-accent);
  }

  .nav-link:focus-visible {
    outline: 2px solid var(--color-bone);
    outline-offset: 4px;
  }

  @media (max-width: 767px) {
    .nav-primary {
      width: 100%;
    }

    .nav-bar-end {
      display: none;
    }

    .nav-list {
      gap: 6vw;
      padding-left: 5vw;
    }

    .nav-link {
      font-size: 0.875rem;
    }
  }
</style>
