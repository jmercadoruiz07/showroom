---
/*
|-------------------------------------------------------------------------------
| SiteHeader — JMR Visuals Portfolio
|-------------------------------------------------------------------------------
|
| Fixed navigation bar across the top, above all page content, in the page
| background colour with white links. On pages with a .hero section it is
| transparent at the top of the page and fills in as soon as the page scrolls.
|
*/
const pathname = Astro.url.pathname;

const links = [
  { href: '/', label: 'Home', matches: ['/'] },
  { href: '/works', label: 'Works', matches: ['/works', '/projects'] },
  { href: '/about', label: 'About', matches: ['/about'] },
];

const isCurrent = (matches: string[]) =>
  matches.some((match) => (match === '/' ? pathname === '/' : pathname.startsWith(match)));
---

<header class="site-header" role="banner">
  <nav class="nav-primary" aria-label="Primary navigation">
    <ul class="nav-list">
      {links.map(({ href, label, matches }) => (
        <li>
          <a href={href} class="nav-link" aria-current={isCurrent(matches) ? 'page' : undefined}>
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  let onScroll: (() => void) | undefined;

  function watchScroll() {
    if (onScroll) window.removeEventListener('scroll', onScroll);
    onScroll = undefined;

    const header = document.querySelector<HTMLElement>('.site-header');
    const hasHero = document.querySelector('.hero') !== null;
    if (!header) return;

    header.toggleAttribute('data-hero', hasHero);
    if (!hasHero) return;

    onScroll = () => header.toggleAttribute('data-scrolled', window.scrollY > 0);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  document.addEventListener('astro:page-load', watchScroll);
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--header-height);
    z-index: var(--z-header);
    pointer-events: none;
  }

  .nav-primary {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: var(--color-bone);
    pointer-events: auto;
    transition: background-color var(--duration-base) var(--ease-standard);
  }

  .site-header[data-hero]:not([data-scrolled]) .nav-primary {
    background: transparent;
  }

  .nav-list {
    --nav-font-size: var(--type-xs);
    display: flex;
    align-items: center;
    gap: 2.5vw;
    height: 100%;
    margin: 0;
    /* Page gutter plus the gallery tab's inner padding, so links share the tab labels' left edge. */
    padding: 0 0 0 calc(var(--space-xl) + 0.7 * var(--nav-font-size));
    list-style: none;
  }

  .nav-list li {
    margin: 0;
  }

  .nav-link {
    display: inline-block;
    padding: 0.3em 0;
    font-family: var(--font-hero-mono);
    font-size: var(--nav-font-size);
    font-weight: var(--font-weight-regular);
    letter-spacing: var(--tracking-wide);
    line-height: 1;
    text-transform: uppercase;
    color: var(--color-chalk);
    /* The underline is a background that grows from the left edge. */
    background: linear-gradient(currentColor, currentColor) no-repeat 0 100% / 0 1px;
    transition: background-size var(--duration-base) var(--ease-standard);
  }

  .nav-link:hover,
  .nav-link:focus-visible,
  .nav-link[aria-current='page'] {
    background-size: 100% 1px;
  }

  .nav-link:focus-visible {
    outline: 2px solid var(--color-chalk);
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-link {
      transition: none;
    }
  }

  @media (max-width: 767px) {
    .nav-list {
      gap: 6vw;
      padding-left: calc(var(--space-md) + 0.7 * var(--nav-font-size));
    }
  }
</style>
