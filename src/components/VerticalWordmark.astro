---
/**
 * Name set vertically along the right edge, reading bottom to top, as an OutlinedWordmark.
 * On pages with a `.hero` the letters start filled and fade to outlines as the hero scrolls away. Hidden below 768px.
 */

import OutlinedWordmark from './OutlinedWordmark.astro';
---

<OutlinedWordmark class="vertical-wordmark" text="Mercado Ruiz" fillNeighbours />

<script>
  let onScroll: (() => void) | undefined;

  function trackHero() {
    if (onScroll) {
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', onScroll);
    }
    onScroll = undefined;

    const wordmark = document.querySelector<HTMLElement>('.vertical-wordmark');
    const hero = document.querySelector<HTMLElement>('.hero');
    if (!wordmark || !hero) return;

    onScroll = () => {
      const progress = Math.min(1, Math.max(0, window.scrollY / hero.offsetHeight));
      wordmark.style.setProperty('--wordmark-fill', String(1 - progress));
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
  }

  document.addEventListener('astro:page-load', trackHero);
</script>

<style>
  /* The class is applied to OutlinedWordmark's root, which this component's scoped styles do not reach. */
  :global(.vertical-wordmark) {
    position: fixed;
    top: var(--header-height);
    right: var(--wordmark-inset);
    bottom: 0;
    z-index: var(--z-wordmark);
    width: var(--wordmark-width);
    /* Round letters overshoot the baseline side of the line box, so only the text's length is clipped. */
    overflow-x: visible;
    overflow-y: clip;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-size: var(--wordmark-size);
    line-height: 0.78;
    /* A zero-offset shadow of the glyphs fills them without disturbing the hover colour transition. */
    text-shadow: 0 0 0 color-mix(in srgb, var(--color-chalk) calc(var(--wordmark-fill, 0) * 100%), transparent);
  }

  @media (max-width: 767px) {
    :global(.vertical-wordmark) {
      display: none;
    }
  }

  /* Pages with a hero start filled so the letters do not flash hollow before the script runs. */
  :global(body:has(.hero)) .vertical-wordmark {
    --wordmark-fill: 1;
  }

  /* Keep the footer clear of the wordmark column. */
  :global(body:has(.vertical-wordmark) .site-footer) {
    margin-right: var(--wordmark-gutter);
  }
</style>
