---
/*
|-------------------------------------------------------------------------------
| VerticalWordmark — JMR Visuals Portfolio
|-------------------------------------------------------------------------------
|
| Name set vertically along the right edge of the screen, reading bottom to top,
| drawn as outlined letters. Hovering a letter fills it and the letters either
| side of it. An optional substring stays filled. Fixed below the header and
| above page content so it stays put while the page scrolls. Size follows the
| viewport height via --wordmark-size; pages that use it reserve
| --wordmark-width on their right side. Hidden below 768px, where
| --wordmark-width is 0.
|
*/
interface Props {
  text?: string;
  fill?: string;
}

const { text = 'Mercado Ruiz', fill = '' } = Astro.props;

const fillStart = fill ? text.toLowerCase().indexOf(fill.toLowerCase()) : -1;

// Spaces become a gap before the next letter so "adjacent" always means a visible letter.
const letters: { char: string; gap: boolean; filled: boolean }[] = [];
let gap = false;
[...text].forEach((char, index) => {
  if (char === ' ') {
    gap = true;
    return;
  }
  const filled = fillStart >= 0 && index >= fillStart && index < fillStart + fill.length;
  letters.push({ char, gap, filled });
  gap = false;
});
---

<p class="vertical-wordmark" aria-hidden="true">
  {letters.map(({ char, gap, filled }) => (
    <span class:list={['letter', { 'has-gap': gap, 'is-filled': filled }]}>{char}</span>
  ))}
</p>

<style>
  .vertical-wordmark {
    position: fixed;
    top: var(--header-height);
    right: 0;
    bottom: 0;
    z-index: var(--z-wordmark);
    width: var(--wordmark-width);
    max-width: none;
    margin: 0;
    overflow: hidden;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-family: var(--font-hero);
    font-size: var(--wordmark-size);
    font-weight: var(--font-weight-black);
    line-height: 0.78;
    text-transform: uppercase;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--color-chalk);
    pointer-events: none;
    user-select: none;
  }

  .letter {
    pointer-events: auto;
    transition: color var(--duration-base) var(--ease-standard);
  }

  .has-gap {
    margin-inline-start: 0.25em;
  }

  .is-filled {
    color: #d9d9d9;
    -webkit-text-stroke: 0;
  }

  .letter:hover,
  .letter:hover + .letter,
  .letter:has(+ .letter:hover) {
    color: var(--color-chalk);
  }

  @media (max-width: 767px) {
    .vertical-wordmark {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .letter {
      transition: none;
    }
  }

  /* Keep the footer clear of the wordmark column. */
  :global(body:has(.vertical-wordmark) .site-footer) {
    margin-right: var(--wordmark-width);
  }
</style>
