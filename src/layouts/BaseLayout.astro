---
/*
|-------------------------------------------------------------------------------
| BaseLayout — JMR Visuals Portfolio
|-------------------------------------------------------------------------------
|
| Root HTML shell with <head>, font preloads, global styles, and slot for page content.
| All pages should use this layout.
| Dark theme is default (matching original portfolio).
|
*/
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
}

const {
  title,
  description = 'Portfolio of JMR Visuals — Print, 3D, and Motion Design',
  ogImage = '/og-default.jpg',
  canonicalURL,
} = Astro.props;

const canonical = canonicalURL || Astro.url.href;
import { ClientRouter } from 'astro:transitions';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

import '../styles/global.css';
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/reset.css';
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | JMR Visuals</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.url).href} />
    <meta property="og:url" content={canonical} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.url).href} />

    <!-- Canonical -->
    <link rel="canonical" href={canonical} />

    <!-- Font Preloads -->
    <link rel="preconnect" href="https://use.typekit.net" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/PlayfairDisplay-Bold.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/InstrumentSans-Regular.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/JetBrainsMono-Regular.woff2" />

    <!-- Critical CSS Inlined -->
    <style>
      {`
        /* Critical path CSS - tokens, reset, fonts, and layout basics */
        :root {
          --color-ink: #ffffff;
          --color-soot: rgba(255, 255, 255, 0.7);
          --color-stone: rgba(255, 255, 255, 0.2);
          --color-bone: #1d1f1f;
          --color-paper: #1d1f1f;
          --color-oxide: oklch(0.55 0.14 45);
          --color-oxide-muted: oklch(0.42 0.10 45);
          --color-deep: #1d1f1f;
          --color-deep-text: #ffffff;

          --font-display: "widescreen", "Playfair Display", Georgia, serif;
          --font-body: "Open Sans", "Instrument Sans", sans-serif;
          --font-mono: "adelle-mono", "JetBrains Mono", monospace;
          --font-ui: "sofia_pro", "Instrument Sans", sans-serif;
          --font-weight-regular: 400;
          --font-weight-bold: 700;
          --tracking-tight: -0.02em;

          --type-base: clamp(1rem, 0.92rem + 0.35vw, 1.125rem);

          --line-height-tight: 1.15;
          --line-height-normal: 1.6;
        }
        *, *::before, *::after { box-sizing: border-box; }
        html { scroll-behavior: smooth; }
        body { margin: 0; min-height: 100vh; font-family: var(--font-body); font-size: var(--type-base); line-height: var(--line-height-normal); color: var(--color-ink); background: #1d1f1f; -webkit-font-smoothing: antialiased; }
        h1, h2, h3, h4, h5, h6 { margin: 0; font-family: var(--font-display); font-weight: var(--font-weight-bold); line-height: var(--line-height-tight); color: var(--color-ink); }
        img, picture, video { display: block; max-width: 100%; height: auto; }
        a { color: inherit; text-decoration: none; }
        .skip-link { position: absolute; top: -100%; left: 1rem; padding: 0.5rem 1rem; background: var(--color-ink); color: var(--color-bone); z-index: 600; }
        .skip-link:focus { top: 1rem; }
      `}
    </style>

    <!-- Client-side Router (View Transitions) -->
    <ClientRouter />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <SiteHeader />
    <slot />
    <SiteFooter />

    <a href="#top" class="back-to-top" aria-label="Back to top">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="15" x2="12" y2="9"></line>
        <line x1="12" y1="9" x2="6" y2="15"></line>
      </svg>
    </a>

    <script is:inline src="/scripts/back-to-top.js"></script>
    <script is:inline src="/scripts/scroll-reveal.js"></script>
  </body>
</html>