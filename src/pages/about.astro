---
/*
|-------------------------------------------------------------------------------
| About Page — JMR Visuals Portfolio
|-------------------------------------------------------------------------------
|
| Figma About frame: contact details and a statement beside the portrait, with
| the hand over an outlined GET IN TOUCH heading.
|
*/
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutSection from '../components/AboutSection.astro';
import VerticalWordmark from '../components/VerticalWordmark.astro';

const statement =
  "Born in Lima, Peru, I now hone my craft in Design and Visual Communication at UTS. I am a multidisciplinary designer focused on creating visual experiences that communicate ideas and evoke emotion. Constantly experimenting across different mediums, my practice bridges thoughtful design and visual storytelling to deliver impactful, memorable work across digital platforms.";
---

<BaseLayout title="About — JMR Visuals" description="Learn more about JMR Visuals, a multidisciplinary designer specializing in print, 3D, and motion design." footer={false}>
  <VerticalWordmark />

  <main id="main-content">
    <AboutSection
      email="jmercadoruiz07@gmail.com"
      statement={statement}
      portrait="/about/temple-portrait.jpg"
      portraitAlt="José Mercado Ruiz standing in a temple courtyard"
    />
  </main>
</BaseLayout>
