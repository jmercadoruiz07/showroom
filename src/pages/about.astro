---
/*
|-------------------------------------------------------------------------------
| About Page — JMR Visuals Portfolio
|-------------------------------------------------------------------------------
|
| Figma About frame: two text columns beside the portrait, the hand over an
| outlined GET IN TOUCH heading, then contact links and a closing statement.
|
*/
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutSection from '../components/AboutSection.astro';
import ContactBlock from '../components/ContactBlock.astro';
import VerticalWordmark from '../components/VerticalWordmark.astro';

const blurb =
  'A multidisciplinary designer specializing in print, 3D, and motion design.';

const text =
  'Based in Barcelona, working globally. With over a decade of experience crafting visual identities, editorial layouts, and immersive 3D experiences, I bridge the gap between traditional design craft and emerging technologies. My work spans brand systems, exhibition design, motion graphics, and real-time 3D applications.';

const statement =
  "I believe design is a conversation between form and function — where every pixel, every curve, and every interaction serves a purpose. Whether it's a printed monograph that lives on a shelf for decades or a WebGL experience that exists only in the browser, the same principles apply: clarity, intention, and craft.";
---

<BaseLayout title="About — JMR Visuals" description="Learn more about JMR Visuals, a multidisciplinary designer specializing in print, 3D, and motion design.">
  <VerticalWordmark />

  <main id="main-content">
    <AboutSection
      blurb={blurb}
      text={text}
      portrait="/about/temple-portrait.jpg"
      portraitAlt="José Mercado Ruiz standing in a temple courtyard"
    />

    <ContactBlock email="hello@jmrvisuals.com" statement={statement} />
  </main>
</BaseLayout>
