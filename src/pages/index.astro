---
/*
|-------------------------------------------------------------------------------
| Home Page — JMR Visuals Portfolio
|-------------------------------------------------------------------------------
|
| Hero slideshow + Project Gallery with Category Filter
| Uses View Transitions for smooth navigation
|
*/
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import CategoryFilter from '../components/CategoryFilter.astro';
import ProjectGallery, { type GalleryProject } from '../components/ProjectGallery.tsx';

const projects = await getCollection('projects');

// Extract unique categories from projects
const categories = [...new Set(projects.map(p => p.data.category))].sort();

// Hero slideshow images - using first image from each project
const heroSlides = projects
  .filter(p => p.data.images && p.data.images.length > 0)
  .slice(0, 5)
  .map(p => ({
    src: p.data.images[0].url,
    alt: p.data.title
  }));

// Map projects to GalleryProject type
const galleryProjects: GalleryProject[] = projects.map(p => ({
  title: p.data.title,
  category: p.data.category,
  thumbnail: {
    url: p.data.images?.[0]?.url || '/placeholder.jpg',
    width: 800,
    height: 600,
  },
  thumbnailAlt: p.data.images?.[0]?.alt || p.data.title,
  href: `/projects/${p.id}/`,
}));

---

<BaseLayout title="JMR Visuals" description="Portfolio of Jose Mercado Ruiz — 3D Artist, Designer, Creative Technologist">
  <main id="main-content">
    <HeroSection slides={heroSlides} />

    <section class="projects-section" aria-labelledby="projects-heading">
      <CategoryFilter categories={categories} />

      <ProjectGallery
        projects={galleryProjects}
        categories={categories}
        client:visible
      />
    </section>
  </main>
</BaseLayout>

<style>
  .projects-section {
    padding-top: 0;
  }
</style>
