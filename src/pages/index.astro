---
/*
|-------------------------------------------------------------------------------
| Home Page — JMR Visuals Portfolio
|-------------------------------------------------------------------------------
|
| Hero collage with a random column of project images + Project Gallery
| with album filter.
|
*/
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import ProjectGallery from '../components/ProjectGallery.astro';
import VerticalWordmark from '../components/VerticalWordmark.astro';
import { getCollection } from 'astro:content';
import { sortProjectsByOrder } from '../lib/sort-projects';

const projects = await getCollection('projects');

const heroSlides = sortProjectsByOrder(projects).map((project) => ({
  src: project.data.thumbnail.url,
  title: project.data.title,
  href: `/projects/${project.id}`,
}));

const heroQuote =
  '‘A Day in 5a’ is a geometric mural exploring the synthesis of typography, grid and the natural environment through a unified modular system. Drawing upon the structural anatomy of Bauhaus design, the composition reduces type and organic elements like sweeping clouds, sun rays, and foliage into a standardized visual language of interlocking arcs, pills, and circles in a vibrant, primary colour palette.';
---

<BaseLayout title="JMR Visuals — Portfolio" description="Multidisciplinary designer specializing in print, 3D, and motion design. Based in Barcelona, working globally.">
  <VerticalWordmark />
  <HeroSection slides={heroSlides} quote={heroQuote} />

  <main id="main-content" class="home-main">
    <ProjectGallery tightTop />
  </main>
</BaseLayout>

<style>
  .home-main {
    padding-right: var(--wordmark-width);
  }
</style>

