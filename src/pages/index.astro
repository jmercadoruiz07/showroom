---
/*
|-------------------------------------------------------------------------------
| Home Page — JMR Visuals Portfolio
|-------------------------------------------------------------------------------
|
| Full-window hero with rotating background images + Project Gallery whose
| FEATURED tab shows four hand-picked projects, each with a chosen image.
|
*/
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import ProjectGallery from '../components/ProjectGallery.astro';
import VerticalWordmark from '../components/VerticalWordmark.astro';
import { assetUrl } from '../utils/asset-url';

const heroImages = [
  assetUrl('hero/slideshow_1.png'),
  assetUrl('hero/slideshow_2.png'),
  assetUrl('hero/slideshow_3.png'),
];

// Project ids and the zero-based index into the project's image assets shown on each accordion item.
const featuredPicks = [
  { id: 'xdDJRX', imageIndex: 2 },
  { id: 'PXbgxr', imageIndex: 0 },
  { id: '6vvvZO', imageIndex: 1 },
  { id: 'Y8Be0P', imageIndex: 0 },
];
---

<BaseLayout title="JMR Visuals — Portfolio" description="Multidisciplinary designer specializing in print, 3D, and motion design. Based in Barcelona, working globally.">
  <VerticalWordmark />
  <HeroSection images={heroImages} />

  <main id="main-content" class="home-main">
    <ProjectGallery tightTop stickyFilter={false} featuredPicks={featuredPicks} />
  </main>
</BaseLayout>

<style>
  .home-main {
    padding-right: var(--wordmark-gutter);
  }
</style>

