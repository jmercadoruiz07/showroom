---
/*
|-------------------------------------------------------------------------------
| Project Detail Page — JMR Visuals Portfolio
|-------------------------------------------------------------------------------
|
| SimpleGrid layout matching original portfolio.
| Hero: full-width project image (first image)
| Title: h1 in widescreen, massive (clamp to 130px max)
| Layout: simpleGrid rows
|   - Row 1: col-4 (description) + col-8 (longer bio/text)
|   - Row 2+: col-4 × 3 image grid
| Description in Open Sans, white
| Metadata (date, tools) in adelle-mono
| Images link to full-size (open in new tab)
|
*/
import { getCollection } from 'astro:content';
import ProjectLayout from '../../layouts/ProjectLayout.astro';

// Generate static paths for all projects
export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { title, date, albums, tags, images, tools, description, category } = project.data;

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(date);
};

---

<ProjectLayout
  title={title}
  description={description}
  ogImage={images?.[0]?.url}
>
  <main id="main-content">
    <article class="project-detail">
      <header class="project-header">
        <a href="/projects" class="back-link">
          ← All Projects
        </a>

        <div class="project-meta">
          <span class="project-category">{category.toUpperCase()}</span>
          <time class="project-date" datetime={date.toISOString()}>
            {formatDate(date)}
          </time>
        </div>

        <h1 class="project-title">{title}</h1>

        {tags && tags.length > 0 && (
          <ul class="project-tags" aria-label="Project tags">
            {tags.map((tag) => (
              <li><span class="tag">{tag.toUpperCase()}</span></li>
            ))}
          </ul>
        )}
      </header>

      <div class="project-grid">
        {/* Hero image - full width */}
        {images && images.length > 0 && (
          <div class="project-hero-image col-12">
            <a href={images[0].url} target="_blank" rel="noopener noreferrer" aria-label={`View full-size: ${title}`}>
              <img src={images[0].url} alt={title} loading="eager" fetchpriority="high" />
            </a>
          </div>
        )}

        {/* Row 1: Description (col-4) + Bio (col-8) */}
        <div class="project-description col-4">
          <div class="description-content" set:html={description} />
        </div>

        <div class="project-bio col-8">
          <div class="bio-content">
            {tools && tools.length > 0 && (
              <section class="project-tools">
                <h2 class="tools-title">TOOLS</h2>
                <ul class="tools-list">
                  {tools.map((tool) => (
                    <li><span class="tool">{tool}</span></li>
                  ))}
                </ul>
              </section>
            )}
          </div>
        </div>

        {/* Row 2+: Image grid - col-4 × 3 */}
        {images && images.length > 1 && (
          images.slice(1).map((image, index) => (
            <div class="project-image col-4">
              <a href={image.url} target="_blank" rel="noopener noreferrer" aria-label={`View full-size image ${index + 2}`}>
                <img src={image.url} alt={`${title} - Image ${index + 2}`} loading="lazy" decoding="async" />
              </a>
            </div>
          ))
        )}
      </div>
    </article>
  </main>
</ProjectLayout>

<style>
  .project-detail {
    padding: 0;
    padding-top: 60px;
  }

  .project-header {
    padding: var(--space-3xl) var(--space-xl) var(--space-xl);
    padding-left: calc(var(--space-xl) * 2);
    max-width: 100%;
  }

  .back-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 20px;
    font-weight: 400;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: var(--space-lg);
    transition: color var(--duration-fast) var(--ease-quick);
  }

  .back-link:hover {
    color: var(--color-oxide);
  }

  .project-meta {
    display: flex;
    gap: var(--space-xl);
    margin-bottom: var(--space-md);
  }

  .project-category,
  .project-date {
    font-family: var(--font-mono);
    font-size: 20px;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.7);
  }

  .project-title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 2rem + 5vw, 130px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0 0 var(--space-lg);
    color: #ffffff;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: var(--type-xs);
    font-weight: 400;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-oxide-muted);
    background: transparent;
    padding: var(--space-2xs) var(--space-sm);
    border: 1px solid var(--color-oxide-muted);
  }

  /* SimpleGrid layout */
  .project-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 0;
    max-width: 100%;
    margin: 0 auto;
    padding: 0 var(--space-xl);
    padding-left: calc(var(--space-xl) * 2);
    padding-bottom: var(--space-3xl);
  }

  .project-grid > * {
    grid-column: span 12;
  }

  .col-4 {
    grid-column: span 4;
  }

  .col-8 {
    grid-column: span 8;
  }

  .col-12 {
    grid-column: span 12;
  }

  @media (max-width: 768px) {
    .project-grid > *,
    .col-4,
    .col-8,
    .col-12 {
      grid-column: span 12;
    }
  }

  .project-hero-image {
    margin: 0 calc(-1 * var(--space-xl)) var(--space-3xl);
    margin-left: calc(-1 * var(--space-xl) * 2);
  }

  .project-hero-image img {
    width: 100%;
    height: auto;
    display: block;
  }

  .project-description {
    padding-right: var(--space-xl);
  }

  .description-content {
    font-family: var(--font-body);
    font-size: var(--type-base);
    line-height: var(--line-height-relaxed);
    color: #ffffff;
  }

  .description-content p {
    margin-bottom: var(--space-md);
  }

  .project-bio {
    padding-left: var(--space-xl);
  }

  .project-tools {
    margin-top: var(--space-2xl);
    padding-top: var(--space-xl);
    border-top: 1px solid rgba(255, 255, 255, 0.2);
  }

  .tools-title {
    font-family: var(--font-mono);
    font-size: 20px;
    font-weight: 400;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-oxide-muted);
    margin: 0 0 var(--space-md);
  }

  .tools-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tool {
    font-family: var(--font-mono);
    font-size: 20px;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.7);
    background: transparent;
    padding: var(--space-2xs) var(--space-sm);
  }

  .project-image {
    margin: 18px 0;
  }

  .project-image img {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (max-width: 1024px) {
    .project-header {
      padding: var(--space-2xl) var(--space-md) var(--space-lg);
      padding-left: var(--space-md);
    }

    .project-grid {
      padding: 0 var(--space-md);
      padding-left: var(--space-md);
    }

    .project-hero-image {
      margin: 0 calc(-1 * var(--space-md)) var(--space-2xl);
      margin-left: calc(-1 * var(--space-md));
    }

    .project-description,
    .project-bio {
      padding: 0;
    }

    .project-title {
      font-size: clamp(2rem, 1.5rem + 4vw, 80px);
    }

    .project-category,
    .project-date {
      font-size: 16px;
    }

    .back-link {
      font-size: 16px;
    }
  }
</style>
