---
/*
|-------------------------------------------------------------------------------
| Projects Index Page — JMR Visuals Portfolio
|-------------------------------------------------------------------------------
|
| Category Filter + Project Gallery
| All projects displayed with client-side filtering
|
*/
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryFilter from '../../components/CategoryFilter.astro';
import ProjectGallery, { type GalleryProject } from '../../components/ProjectGallery.tsx';

const projects = await getCollection('projects');
const categories = [...new Set(projects.map(p => p.data.category))].sort();

// Get active category from URL query param
const activeCategory = Astro.url.searchParams.get('category') || 'renders';

const galleryProjects: GalleryProject[] = projects.map(p => ({
  title: p.data.title,
  category: p.data.category,
  thumbnail: {
    url: p.data.images?.[0]?.url || '/placeholder.jpg',
    width: 800,
    height: 600,
  },
  thumbnailAlt: p.data.images?.[0]?.alt || p.data.title,
  href: `/projects/${p.id}/`,
}));

---

<BaseLayout title="Projects — JMR Visuals" description="All projects by Jose Mercado Ruiz">
  <main id="main-content">
    <header class="projects-header">
      <h1 class="projects-title">PROJECTS</h1>
    </header>

    <CategoryFilter categories={categories} activeCategory={activeCategory} />

    <ProjectGallery
      projects={galleryProjects}
      categories={categories}
      activeCategory={activeCategory}
      client:visible
    />
  </main>
</BaseLayout>

<style>
  .projects-header {
    padding: var(--space-3xl) var(--space-xl) var(--space-lg);
    padding-left: calc(var(--space-xl) * 2);
  }

  .projects-title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 2rem + 5vw, 130px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0;
    color: #ffffff;
  }

  @media (max-width: 1024px) {
    .projects-header {
      padding: var(--space-2xl) var(--space-md) var(--space-md);
      padding-left: var(--space-md);
    }

    .projects-title {
      font-size: clamp(2rem, 1.5rem + 4vw, 80px);
    }
  }
</style>
