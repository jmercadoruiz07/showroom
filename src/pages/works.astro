---
/**
 * Works page: every project with the album filter.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectGallery from '../components/ProjectGallery.astro';
import VerticalWordmark from '../components/VerticalWordmark.astro';
---

<BaseLayout title="Works" description="All projects by JMR Visuals — print, 3D, and motion design.">
  <VerticalWordmark />
  <main class="works-page" id="main-content">
    <header class="works-header">
      <h1 class="works-title text-display">PROJECTS</h1>
    </header>

    <ProjectGallery />
  </main>
</BaseLayout>

<style>
  .works-page {
    padding-top: var(--header-height);
    padding-right: var(--wordmark-gutter);
  }

  .works-header {
    padding: var(--space-3xl) var(--space-xl) var(--space-xl);
    padding-left: calc(var(--space-xl) * 2);
  }

  .works-title {
    font-size: calc(var(--type-hero) * 1.6);
    font-weight: var(--font-weight-black);
    letter-spacing: -0.06em;
    line-height: 0.85;
    margin: 0 0 var(--space-md);
  }

  @media (max-width: 768px) {
    .works-header {
      padding: var(--space-2xl) var(--space-md) var(--space-lg);
    }

    .works-title {
      font-size: calc(var(--type-2xl) * 1.5);
    }
  }
</style>
