---
/**
 * Project detail page: media on one side and the title, description and tools on the other, alternating per project.
 */

import { getCollection } from 'astro:content';
import ProjectLayout from '../../layouts/ProjectLayout.astro';
import ProjectMedia from '../../components/ProjectMedia/ProjectMedia';
import { pageUrl } from '../../utils/asset-url';
import { firstImage } from '../../utils/project-media';
import { extractActions } from '../../utils/project-actions';

const { project } = Astro.props;
const { title, date, albums, tags, media, tools, featured } = project.data;
const { description, actions } = extractActions(project.data.description);
const hasDescription = description !== undefined && description.trim() !== '' && !/^(<p>\s*<\/p>\s*)+$/.test(description.trim());

/** Generates a page for every project. */
export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const firstMedia = media[0];
const displayAlbum = albums?.[0] ?? '';

/** Media and text swap sides on alternate projects. */
const isEven = (project.data.order || 0) % 2 === 0;
const mediaFirst = isEven;

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(date);
};
---

<ProjectLayout
  title={title}
  description={description}
  ogImage={firstImage(media)?.url ?? (firstMedia?.type === 'video' ? firstMedia.poster.url : undefined)}
>
  <main id="main-content">
  <article class="project-detail">
    <header class="project-header">
      <a href={pageUrl('/works')} class="back-link text-mono">
        ← All Projects
      </a>

      <div class="project-meta">
        <span class="project-category text-mono">{displayAlbum.toUpperCase()}</span>
        <time class="project-date text-mono" datetime={date.toISOString()}>
          {formatDate(date)}
        </time>
      </div>

      <h1 class="project-title text-display">{title}</h1>

      {actions.length > 0 && (
        <div class="project-actions">
          {actions.map((action) => (
            <a
              class="action-button text-mono"
              href={action.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              {action.icon === 'play' && (
                <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M7 4v16l13-8z" fill="currentColor" />
                </svg>
              )}
              {action.label}
            </a>
          ))}
        </div>
      )}
    </header>

    <div class="project-grid" style={`--columns: ${mediaFirst ? '3fr 2fr' : '2fr 3fr'}`}>
      <div class={`project-media ${mediaFirst ? 'media-first' : 'media-last'}`}>
        {media.length > 0 ? (
          <ProjectMedia media={media} title={title} client:load />
        ) : (
          <div class="media-placeholder">
            <p class="text-soot">No media available</p>
          </div>
        )}
      </div>

      <div class={`project-text ${mediaFirst ? 'text-last' : 'text-first'}`}>
        {hasDescription && (
          <div class="project-description text-body" set:html={description} />
        )}

        {tags && tags.length > 0 && (
          <section class="project-section">
            <h2 class="section-title text-mono">TAGS</h2>
            <ul class="project-tags">
              {tags.map((tag) => (
                <li><span class="tag text-mono">{tag.toUpperCase()}</span></li>
              ))}
            </ul>
          </section>
        )}

        {tools && tools.length > 0 && (
          <section class="project-section">
            <h2 class="section-title text-mono">TOOLS</h2>
            <ul class="tools-list">
              {tools.map((tool) => (
                <li><span class="tool text-mono">{tool}</span></li>
              ))}
            </ul>
          </section>
        )}

        {featured && (
          <div class="featured-badge text-mono">FEATURED PROJECT</div>
        )}
      </div>
    </div>
  </article>
  </main>
</ProjectLayout>

<style>
  .project-detail {
    padding: var(--space-2xl) var(--space-xl);
    padding-left: calc(var(--space-xl) * 2);
    padding-top: calc(var(--header-height) + var(--space-2xl));
  }

  .project-header {
    max-width: var(--max-width-prose);
    margin: 0 auto var(--space-3xl);
  }

  .back-link {
    display: inline-block;
    font-size: var(--type-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-soot);
    margin-bottom: var(--space-lg);
    transition: color var(--duration-fast) var(--ease-quick);
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .project-meta {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-md);
  }

  .project-category,
  .project-date {
    font-size: var(--type-sm);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .project-category {
    line-height: 1;
    color: var(--color-bone);
    background: var(--color-chalk);
    padding: 0.3em 0.7em;
  }

  .project-title {
    font-size: calc(var(--type-hero) * 1.4);
    font-weight: var(--font-weight-black);
    letter-spacing: -0.06em;
    line-height: 0.9;
    margin: 0 0 var(--space-lg);
    max-width: 60ch;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tag {
    font-size: var(--type-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-chalk);
    border: 1px solid var(--color-chalk);
    padding: var(--space-2xs) var(--space-sm);
  }

  .project-grid {
    display: grid;
    grid-template-columns: var(--columns);
    gap: var(--space-3xl);
    max-width: 100%;
    margin: 0 auto;
  }

  .media-first {
    grid-column: 1;
    order: 1;
  }

  .media-last {
    grid-column: 2;
    order: 2;
  }

  .text-first {
    grid-column: 1;
    order: 1;
  }

  .text-last {
    grid-column: 2;
    order: 2;
  }

  .media-placeholder {
    aspect-ratio: 4 / 3;
    background: var(--color-paper);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .project-text {
    position: sticky;
    top: calc(var(--header-height) + var(--space-xl));
    max-width: var(--max-width-prose);
    align-self: start;
  }

  .project-description {
    font-family: var(--font-text);
    font-weight: var(--font-weight-medium);
    font-size: var(--type-base);
    line-height: var(--line-height-relaxed);
    margin-bottom: calc(var(--space-2xl) / 2);
  }

  .project-description p {
    margin-bottom: var(--space-md);
    max-width: none;
  }

  .project-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .action-button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--type-xs);
    letter-spacing: var(--tracking-wide);
    line-height: 1;
    text-transform: uppercase;
    color: var(--color-bone);
    background: var(--color-chalk);
    padding: 0.9em 1.4em;
    transition: background-color var(--duration-fast) var(--ease-quick);
  }

  .action-button:hover {
    background: color-mix(in srgb, var(--color-chalk) 75%, var(--color-bone));
  }

  .action-button:focus-visible {
    outline: 2px solid var(--color-chalk);
    outline-offset: 2px;
  }

  .action-icon {
    width: 1.1em;
    height: 1.1em;
    flex: none;
  }

  .project-section {
    margin-block: calc(var(--space-2xl) / 2);
    padding-top: calc(var(--space-xl) / 2);
    border-top: 1px solid var(--color-chalk);
  }

  .section-title {
    font-size: var(--type-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-soot);
    margin: 0 0 var(--space-md);
  }

  .tools-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tool {
    font-size: var(--type-sm);
    color: var(--color-ink);
    background: var(--color-paper);
    padding: var(--space-2xs) var(--space-sm);
  }

  .featured-badge {
    font-size: var(--type-xs);
    letter-spacing: var(--tracking-wide);
    line-height: 1;
    text-transform: uppercase;
    color: var(--color-bone);
    background: var(--color-chalk);
    padding: 0.4em 0.8em;
    display: inline-block;
  }

  @media (max-width: 1024px) {
    .project-grid {
      grid-template-columns: 1fr;
      gap: var(--space-2xl);
    }

    .media-first,
    .media-last,
    .text-first,
    .text-last {
      grid-column: auto;
    }

    .media-first,
    .media-last {
      order: 1;
    }

    .text-first,
    .text-last {
      order: 2;
    }

    .project-text {
      position: static;
    }

    .project-title {
      font-size: var(--type-2xl);
    }
  }

  @media (max-width: 768px) {
    .project-detail {
      padding: var(--space-xl) var(--space-md);
      padding-top: calc(var(--header-height) + var(--space-xl));
      padding-left: var(--space-md);
    }

    .project-meta {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-xs);
    }

    .project-title {
      font-size: var(--type-xl);
    }
  }
</style>